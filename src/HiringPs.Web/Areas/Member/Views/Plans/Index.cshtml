@model PlanCatalog
@{ ViewData["Title"] = T["MyPlan"]; var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"; }
<h1>@T["MyPlan"]</h1>
<partial name="_SubscriptionList" model="Model.Subscriptions" />
<h2>@T["ViewPlans"]</h2>
<section data-plan-catalog data-refresh-url="@Url.Action("Catalog")"
         data-events-url="@Url.Action("Stream", "PlanUpdates", new { area = "" })" aria-live="polite">
    <partial name="_Catalog" model="Model.Plans" />
</section>
@section Scripts {
    <script src="~/js/plan-catalog.js" asp-append-version="true" defer></script>
}
