@model WalletCheckoutPage
@{ ViewData["Title"] = T["WalletEnterMobile"]; }
<h1>@T["WalletEnterMobile"]</h1>
@if (Model.IsSandbox)
{
    <p class="notice">@T["WalletSandboxNotice"]</p>
}
<partial name="/Areas/Member/Views/WalletPayments/_WalletCheckout.cshtml" model="Model" />
@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true" defer></script>
}
