@model AdminPage<AdminMemberSummaryDto>
@{ ViewData["Title"] = T["Members"].Value; }
<section class="admin-list-page">
    <header class="admin-page-heading">
        <h1>@T["Members"]</h1>
    </header>
    <form method="get" class="membership-card admin-filters">
        <label>@T["Search"]<input name="q" value="@Context.Request.Query["q"]" />
        </label>
        <label>@T["AccountState"]<select name="suspended">
                <option value="">@T["All"]</option>
                <option value="true" selected="@(Context.Request.Query["suspended"] == "true")">@T["Suspended"]</option>
                <option value="false" selected="@(Context.Request.Query["suspended"] == "false")">@T["Active"]</option>
            </select>
        </label>
        <label>@T["TelegramLinked"]<select name="linked">
                <option value="">@T["All"]</option>
                <option value="true" selected="@(Context.Request.Query["linked"] == "true")">@T["Yes"]</option>
                <option value="false" selected="@(Context.Request.Query["linked"] == "false")">@T["No"]</option>
            </select>
        </label>
        <label>@T["PlanId"]<input name="planId" type="number" min="1" value="@Context.Request.Query["planId"]" />
        </label>
        <button class="button button-outline admin-action" type="submit">
            <span class="fa-solid fa-filter" aria-hidden="true"></span>
            <span>@T["Filter"]</span>
        </button>
    </form>
    <div class="table-wrap">
        <table class="table-nowrap">
            <thead>
                <tr>
                    <th>@T["Name"]</th>
                    <th>@T["Mobile"]</th>
                    <th>@T["Status"]</th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Items)
                {
                    <tr>
                        <td>@member.Name</td>
                        <td>
                            <bdi>@member.Mobile</bdi>
                        </td>
                        <td>@T[member.Suspended ? "Suspended" : member.Activated ? "Active" : "AwaitingVerification"]</td>
                        <td>
                            <a class="button button-outline admin-icon-button" asp-action="Details" asp-route-id="@member.UserId" aria-label="@T["Details"]" title="@T["Details"]">
                                <span class="fa-solid fa-eye" aria-hidden="true"></span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPagination" model="Model.Pager" />
</section>
