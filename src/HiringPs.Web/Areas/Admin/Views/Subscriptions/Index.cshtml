@model AdminPage<SubscriptionSummaryDto>
@{ ViewData["Title"] = T["Subscriptions"].Value; }
<section class="admin-list-page">
    <header class="admin-page-heading">
        <h1>@T["Subscriptions"]</h1>
    </header>
    <form method="get" class="membership-card admin-filters">
        <label>@T["Search"]<input name="q" value="@Context.Request.Query["q"]" />
        </label>
        <label>@T["Status"]<select name="status">
                <option value="">@T["All"]</option>
                @foreach (var state in new[] { "current", "scheduled", "expired", "cancelled" })
                {
                    <option value="@state" selected="@(Context.Request.Query["status"] == state)">@T["Subscription" + state]</option>
                }
            </select>
        </label>
        <button class="button button-outline admin-action" type="submit">
            <span class="fa-solid fa-filter" aria-hidden="true"></span>
            <span>@T["Filter"]</span>
        </button>
    </form>
    <div class="table-wrap">
        <table class="table-nowrap">
            <thead>
                <tr>
                    <th>@T["MemberName"]</th>
                    <th>@T["Plan"]</th>
                    <th>@T["CreatedPalestineTime"]</th>
                    <th>@T["StartsPalestineTime"]</th>
                    <th>@T["EndsPalestineTime"]</th>
                    <th>@T["Status"]</th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-controller="Members" asp-action="Details" asp-route-id="@sub.UserId">@(string.IsNullOrWhiteSpace(sub.MemberName) ? T["UnknownMember"].Value : sub.MemberName)</a>
                        </td>
                        <td>@sub.PlanVersion.Name(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</td>
                        <td><bdi dir="ltr">@PaymentDisplay.Time(sub.CreatedAt)</bdi></td>
                        <td>
                            <bdi>@PaymentDisplay.Time(sub.StartsAt)</bdi>
                        </td>
                        <td>
                            <bdi>@PaymentDisplay.Time(sub.EndsAt)</bdi>
                        </td>
                        <td>@T[sub.Cancelled ? "Subscriptioncancelled" : sub.StartsAt > DateTimeOffset.UtcNow ? "Subscriptionscheduled" : sub.EndsAt > DateTimeOffset.UtcNow ? "Subscriptioncurrent" : "Subscriptionexpired"]</td>
                        <td>
                            @if (!sub.Cancelled)
                            {
                                <form class="admin-inline-form" asp-action="Cancel" method="post">
                                    <input name="id" value="@sub.Id" type="hidden" />
                                    <label>@T["Reason"]<input name="reason" required maxlength="1500" />
                                    </label>
                                    <button class="button button-outline admin-action" type="submit">
                                        <span class="fa-solid fa-circle-pause" aria-hidden="true"></span>
                                        <span>@T["StopSubscription"]</span>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPagination" model="Model.Pager" />
    <form asp-controller="Subscriptions" asp-action="PreviewGrant" method="post" class="membership-card admin-grant-form">
        <h2>@T["GrantSubscription"]</h2>
        <label>
            @T["Email"]
            <input name="Email" type="email" dir="ltr" maxlength="256" value="@(Context.Request.Query["q"].ToString().Contains('@') ? Context.Request.Query["q"].ToString() : "")" required />
        </label>
        <label>
            @T["Plan"]
            <select name="versionId">
                @foreach (var version in (List<MembershipPlanLabelDto>)ViewBag.Plans)
                {
                    <option value="@version.Id">@version.Name(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</option>
                }
            </select>
        </label>
        <label>
            @T["CustomDays"]
            <input name="days" type="number" min="1" max="3650" />
        </label>
        <label class="admin-wide">
            @T["Reason"]
            <textarea name="reason" required maxlength="1500"></textarea>
        </label>
        <button class="button button-outline admin-action" type="submit">
            <span class="fa-solid fa-check" aria-hidden="true"></span>
            <span>@T["ReviewMemberBeforeGrant"]</span>
        </button>
    </form>
</section>
