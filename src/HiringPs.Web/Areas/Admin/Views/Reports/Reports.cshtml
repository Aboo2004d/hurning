@model AdminPage<UserReportSummaryDto>
@{
    ViewData["Title"] = T["Reports"];
}
<h1>@T["Reports"]</h1>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>@T["Title"]</th>
                <th>@T["ReportReason"]</th>
                <th>@T["ReportDetails"]</th>
                <th>@T["Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model.Items)
            {
                <tr>
                    <td>
                        <a asp-controller="Opportunities" asp-action="Edit" asp-route-id="@report.OpportunityId">@report.OpportunityTitle</a>
                    </td>
                    <td>@T[report.Reason=="expired"?"Report_expired":report.Reason]</td>
                    <td>@report.Details</td>
                    <td>@(report.Resolved?T["Resolved"]:T["Review"])</td>
                    <td>
                        @if (!report.Resolved)
                        {
                            <form asp-controller="Reports" asp-action="Resolve" method="post">
                                <input type="hidden" name="id" value="@report.Id"/>
                                <button class="button-outline" type="submit">@T["Resolve"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_AdminPagination" model="Model.Pager" />
