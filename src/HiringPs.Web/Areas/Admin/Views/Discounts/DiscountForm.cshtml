@model DiscountCode
@{ ViewData["Title"] = T[Model.Id == 0 ? "AddDiscount" : "EditDiscount"].Value; }
<h1>@ViewData["Title"]</h1>
<form asp-area="Admin" asp-controller="Discounts" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post" class="membership-card">
    <input asp-for="Id" type="hidden" />
    <label>@T["DiscountCode"]<input asp-for="Code" required dir="ltr" maxlength="50" />
    </label>
    <label>@T["Plan"]<select asp-for="PlanId">@foreach (var plan in (List<MembershipPlanVersion>)ViewBag.Plans)
                {
                    <option value="@plan.PlanId">@plan.Name(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</option>
                    }</select>
            </label>
            <label>@T["DiscountPercent"]<input asp-for="Percent" type="number" min="0" max="100" required />
            </label>
            <label>@T["MaximumUses"]<input asp-for="MaximumUses" type="number" min="1" required />
            </label>
            <label>@T["EndsUtc"]<input asp-for="ExpiresAt" type="datetime-local" required />
            </label>
            <label class="check">
                <input asp-for="Enabled" />@T["Enabled"]</label>
            <button type="submit">@T["Save"]</button>
        </form>
