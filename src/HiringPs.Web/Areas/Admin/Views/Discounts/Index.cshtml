@model AdminPage<DiscountCode>
@{ ViewData["Title"] = T["Discounts"].Value; }
<section class="admin-list-page">
    <header class="admin-page-heading">
        <h1>@T["Discounts"]</h1>
        <div class="actions">
            <a class="button button-outline admin-action" asp-action="Create">
                <span class="fa-solid fa-plus" aria-hidden="true"></span>
                <span>@T["Add"]</span>
            </a>
        </div>
    </header>

    <div class="table-wrap">
        <table class="table-nowrap">
            <thead>
                <tr>
                    <th>@T["DiscountCode"]</th>
                    <th>@T["PlanId"]</th>
                    <th>%</th>
                    <th>@T["EndsUtc"]</th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var code in Model.Items)
                {
                    <tr>
                        <td>
                            <bdi>@code.Code</bdi>
                        </td>
                        <td>@(code.PlanId is null ? T["AllPlans"].Value : code.PlanId.Value.ToString())</td>
                        <td>@code.Percent</td>
                        <td>
                            <bdi>@code.ExpiresAt.ToString("yyyy-MM-dd HH:mm")</bdi>
                        </td>
                        <td>
                            <a class="button button-outline admin-icon-button" asp-action="Edit" asp-route-id="@code.Id" aria-label="@T["Edit"]" title="@T["Edit"]">
                                <span class="fa-solid fa-pen-to-square" aria-hidden="true"></span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPagination" model="Model.Pager" />
</section>
