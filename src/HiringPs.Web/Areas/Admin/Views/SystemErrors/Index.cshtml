@model SystemErrorsPage
@{ ViewData["Title"] = T["SystemErrors"].Value; }
<section class="admin-list-page operation-log system-errors">
<header class="admin-page-heading"><div><h1>@T["SystemErrors"]</h1><p class="muted">@T["SystemErrorsHelp"]</p></div><span class="badge"><bdi>@Model.Errors.Pager.TotalRecords</bdi> @T["SystemErrorsCount"]</span></header>
<form method="get" class="operation-filters">
<label>@T["Search"]<input name="Search" value="@Model.Filter.Search" maxlength="200" placeholder="@T["SystemErrorsSearch"]" /></label>
<label>@T["SystemErrorsApplication"]<select name="Application"><option value="">@T["All"]</option>@foreach (var app in new[] { "Web", "Worker" }) { <option value="@app" selected="@(Model.Filter.Application == app)">@T["SystemErrorsApp_" + app]</option> }</select></label>
<label>@T["SystemErrorsLevel"]<select name="Level"><option value="">@T["All"]</option>@foreach (var level in new[] { "Warning", "Error", "Critical" }) { <option value="@level" selected="@(Model.Filter.Level == level)">@T["SystemErrorsLevel_" + level]</option> }</select></label>
<label>@T["OperationFrom"]<input type="date" name="From" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" /></label>
<label>@T["OperationTo"]<input type="date" name="To" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" /></label>
<div class="actions"><button type="submit">@T["Filter"]</button><a class="button button-outline" asp-action="Index">@T["OperationReset"]</a></div>
</form>
@if (Model.Errors.Items.Count == 0) { <p class="notice">@T["SystemErrorsEmpty"]</p> }
else {
<div class="operation-events">
@foreach (var entry in Model.Errors.Items) {
<article class="operation-event operation-failed">
<header><span class="badge">@T["SystemErrorsApp_" + entry.Application]</span><strong>@T["SystemErrorsLevel_" + entry.Level]</strong><time datetime="@entry.At.ToString("O")"><bdi>@PaymentDisplay.Time(entry.At, seconds: true)</bdi> · @T["PalestineTime"]</time></header>
<h2 dir="auto">@(string.IsNullOrEmpty(entry.ExceptionType) ? entry.Category : entry.ExceptionType)</h2>
<p dir="auto">@entry.Message</p>
<dl class="system-error-meta"><dt>@T["SystemErrorsReference"]</dt><dd><bdi>@entry.TraceId</bdi></dd><dt>@T["SystemErrorsPath"]</dt><dd><bdi>@entry.Path</bdi></dd></dl>
<a class="button button-outline" asp-action="Details" asp-route-id="@entry.Id">@T["SystemErrorsDetails"]</a>
</article>
}
</div>
}
<partial name="_AdminPagination" model="Model.Errors.Pager" />
</section>
