@model AdminPage<AdminPlanSummaryDto>
@{
    ViewData["Title"] = T["Plans"].Value;
}
<section class="admin-list-page">
    <header class="admin-page-heading">
        <h1>@T["Plans"]</h1>
        <div class="actions">
            <a class="button button-outline admin-action" asp-action="Create">
                <span class="fa-solid fa-plus" aria-hidden="true"></span>
                <span>@T["AddPlan"]</span>
            </a>
            <a class="button button-outline admin-action" asp-action="Access">
                <span class="fa-solid fa-list" aria-hidden="true"></span>
                <span>@T["TypeAccess"]</span>
            </a>
        </div>
    </header>
    <section data-plan-catalog data-refresh-url="@Context.Request.PathBase@Context.Request.Path@Context.Request.QueryString"
             data-events-url="@Url.Action("Stream", "PlanUpdates", new { area = "" })" aria-live="polite">
        <partial name="_PlanTable" model="Model" />
    </section>
</section>

@section Scripts {
    <script src="~/js/plan-catalog.js" asp-append-version="true" defer></script>
}
