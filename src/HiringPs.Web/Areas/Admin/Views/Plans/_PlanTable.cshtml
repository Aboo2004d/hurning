@model AdminPage<AdminPlanSummaryDto>
    <div class="table-wrap" data-plan-fragment>
        <table class="table-nowrap">
            <thead>
                <tr>
                    <th>@T["PlanId"]</th>
                    <th>@T["Plan"]</th>
                    <th>@T["Amount"]</th>
                    <th>@T["Visible"]</th>
                    <th>@T["Edit"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var plan in Model.Items)
                {
                    var version = plan.CurrentVersion;
                    <tr>
                        <td>@plan.Id</td>
                        <td>@version.Name(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</td>
                        <td><bdi dir="ltr">@MembershipRules.Money(version.PriceIls)</bdi></td>
                        <td>@T[plan.Visible ? "Yes" : "No"]</td>
                        <td>
                            <a class="button button-outline admin-icon-button" asp-action="Edit" asp-route-id="@plan.Id"
                               aria-label="@T["Edit"]" title="@T["Edit"]">
                                <span class="fa-solid fa-pen-to-square" aria-hidden="true"></span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPagination" model="Model.Pager" />
