@model AdminPage<MemberMessageSummaryDto>
@{ ViewData["Title"] = T["NotificationDelivery"].Value; }
<section class="admin-list-page">
    <header class="admin-page-heading">
        <h1>@T["NotificationDelivery"]</h1>
    </header>
    <form method="get" class="membership-card admin-filters">
        <label>@T["Email"]<input name="email" type="email" dir="ltr" maxlength="256" value="@Context.Request.Query["email"]" />
            @if (ViewBag.FilterMemberName is string memberName) { <span class="muted" dir="auto">@memberName</span> }
        </label>
        <label>@T["Status"]<select name="state">
                <option value="">@T["All"]</option>
                @foreach (var state in new[] { "pending", "failed", "sent", "cancelled" })
                {
                    <option value="@state" selected="@(Context.Request.Query["state"] == state)">@T["Delivery" + state]</option>
                }
            </select>
        </label>
        <button class="button button-outline admin-action" type="submit">
            <span class="fa-solid fa-filter" aria-hidden="true"></span>
            <span>@T["Filter"]</span>
        </button>
    </form>
    <div class="table-wrap">
        <table class="table-nowrap">
            <thead>
                <tr>
                    <th>@T["MemberName"]</th>
                    <th>@T["Message"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Attempts"]</th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-controller="Members" asp-action="Details" asp-route-id="@message.UserId">@(string.IsNullOrWhiteSpace(message.MemberName) ? T["UnknownMember"].Value : message.MemberName)</a>
                        </td>
                        <td class="admin-message-cell" dir="auto">@message.Text</td>
                        <td>@T[message.SentAt != null ? "Deliverysent" : message.CancelledAt != null ? "Deliverycancelled" : message.LastError.Length > 0 ? "Deliveryfailed" : "Deliverypending"]<br />@T[message.LastError]</td>
                        <td>@message.Attempts</td>
                        <td>
                            @if (message.SentAt is null && message.CancelledAt is null)
                            {
                                <form asp-action="Retry" method="post">
                                    <input name="id" value="@message.Id" type="hidden" />
                                    <button class="button button-outline admin-action" type="submit">
                                        <span class="fa-solid fa-rotate-right" aria-hidden="true"></span>
                                        <span>@T["Retry"]</span>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPagination" model="Model.Pager" />
    @if (ViewBag.Inbox is AdminPage<TelegramInboxSummaryDto> inbox)
        {
            <h2 id="bot-inbox">@T["BotInbox"]</h2>
            <div class="table-wrap">
                <table class="table-nowrap">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@T["CreatedPalestineTime"]</th>
                            <th>@T["Attempts"]</th>
                            <th>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var update in inbox.Items)
                        {
                            <tr>
                                <td>@update.Id</td>
                                <td>
                                    <bdi>@PaymentDisplay.Time(update.ReceivedAt)</bdi>
                                </td>
                                <td>@update.Attempts</td>
                                <td>
                                    <form asp-action="RetryInbox" method="post">
                                        <input name="id" value="@update.Id" type="hidden" />
                                        <button class="button button-outline admin-action" type="submit">
                                            <span class="fa-solid fa-rotate-right" aria-hidden="true"></span>
                                            <span>@T["Retry"]</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_AdminPagination" model="inbox.Pager" />
        }
</section>
