@model AdminPage<PaymentOrder>
    <h1>@T["Payments"]</h1>
    <form method="get" class="membership-card">
        <label>@T["ReferenceOrOrder"]<input name="q" value="@Context.Request.Query["q"]" />
        </label>
        <label>@T["PaymentGateway"]<select name="gateway">
                <option value="">@T["All"]</option>@foreach (var gateway in new[] { "Lahza", "JawwalPay", "discount" })
                {
                    <option value="@gateway" selected="@(Context.Request.Query["gateway"] == gateway)">@gateway</option>
                    }</select>
            </label>
            <label>@T["Status"]<select name="state">
                    <option value="">@T["All"]</option>@foreach (var state in Enum.GetValues<PaymentState>())
                        {
                            <option value="@state" selected="@(Context.Request.Query["state"] == state.ToString())">@T["Payment" + state]</option>
                            }</select>
                    </label>
                    <label class="check">
                        <input name="review" type="checkbox" value="true" checked="@(Context.Request.Query["review"] == "true")" />@T["ReviewPending"]</label>
                    <button type="submit">@T["Filter"]</button>
                </form>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>@T["OrderId"]</th>
                                <th>@T["Amount"]</th>
                                <th>@T["Status"]</th>
                                <th>@T["Reference"]</th>
                                <th>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <bdi>@order.Id</bdi>
                                    </td>
                                    <td>@MembershipRules.Money(order.AmountIls)</td>
                                    <td>@T["Payment" + order.State]</td>
                                    <td dir="auto">@order.ProviderReference</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.Id">@T["Details"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_AdminPagination" model="Model.Pager" />
