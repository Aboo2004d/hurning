@model AdminPage<PaymentOrderSummaryDto>
@{
    var titleKey = Context.Request.Query["gateway"].ToString() switch
    {
        "Lahza" => "PaymentsLahza",
        "JawwalPay" => "PaymentsJawwalPay",
        _ => "Payments"
    };
    ViewData["Title"] = T[titleKey].Value;
}
<section class="admin-list-page">
    <header class="admin-page-heading">
        <h1>@T[titleKey]</h1>
    </header>
    <form method="get" class="membership-card admin-filters">
        <label>@T["ReferenceOrOrder"]
            <input name="q" value="@Context.Request.Query["q"]" />
        </label>
        <label>@T["PaymentGateway"]
            <select name="gateway">
                <option value="">@T["All"]</option>
                @foreach (var gateway in new[] { "Lahza", "JawwalPay", "discount" })
                {
                    <option value="@gateway" selected="@(Context.Request.Query["gateway"] == gateway)">@T[gateway == "discount" ? "DiscountPayment" : gateway]</option>
                }
            </select>
        </label>
        <label>@T["PaymentEnvironment"]
            <select name="environment">
                <option value="">@T["All"]</option>
                @foreach (var environment in new[] { "Sandbox", "Production" })
                {
                    <option value="@environment" selected="@(Context.Request.Query["environment"] == environment)">@T["PaymentEnvironment" + environment]</option>
                }
            </select>
        </label>
        <label>@T["Status"]
            <select name="state">
                <option value="">@T["All"]</option>
                @foreach (var state in Enum.GetValues<PaymentState>())
                {
                    <option value="@state" selected="@(Context.Request.Query["state"] == state.ToString())">@T["Payment" + state]</option>
                }
            </select>
        </label>
        <label class="check">
            <input name="review" type="checkbox" value="true" checked="@(Context.Request.Query["review"] == "true")" />@T["ReviewPending"]
        </label>
        <label class="check">
            <input name="unresolved" type="checkbox" value="true" checked="@(Context.Request.Query["unresolved"] == "true")" />@T["PaymentNeedsReconciliation"]
        </label>
        <button class="button button-outline admin-action" type="submit">
            <span class="fa-solid fa-filter" aria-hidden="true"></span>
            <span>@T["Filter"]</span>
        </button>
    </form>
    <partial name="/Areas/Admin/Views/Payments/_PaymentTable.cshtml" model="Model" />
</section>
@section Scripts {
    <script src="~/js/payment-list.js" asp-append-version="true" defer></script>
}
