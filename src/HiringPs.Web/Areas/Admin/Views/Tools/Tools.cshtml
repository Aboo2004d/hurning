@model ToolDashboard
@{
    ViewData["Title"] = T["Tools"];
    string PalestineTime(DateTimeOffset? instant) => instant is { } value
        ? PaymentDisplay.Time(value, seconds: true)
        : "—";
    var workerFresh = ToolMonitoringRules.WorkerFresh(Model.Worker, Model.Now);
    var collectorFailed = Model.Worker?.LastFailureAt is { } failure && (Model.Worker.LastSuccessAt is null || failure > Model.Worker.LastSuccessAt);
}
<p class="notice" role="status" data-tools-feedback hidden
   data-queued="@T["ToolsCheckQueued"]" data-existing="@T["ToolsCheckAlreadyQueued"]"
   data-error="@T["ToolsFetchFailed"]"></p>
<div data-tools-dashboard data-pending="@(Model.HasPendingChecks ? "true" : "false")">
<h1>@T["Tools"]</h1>
@if (Context.Request.Query["googleTest"] == "failed")
{
    <p class="notice" role="alert">@T["GoogleFailed"]</p>
}
<p class="notice">@T["ToolsIntroPalestine"]</p>
<div class="actions tools-actions">
    <form asp-controller="Tools" asp-action="CheckTools" method="post">
        <button type="submit">@T["ToolsCheckAll"]</button>
    </form>
    <a class="button button-outline" asp-controller="Tools" asp-action="Tools">@T["ToolsRefresh"]</a>
</div>
<p class="muted">@T["ToolsAllCost"]</p>
@if (Model.HasPendingChecks)
{
    <p class="notice" role="status">@T["ToolsCheckAlreadyQueued"]</p>
}
@if (!workerFresh)
{
    <p class="notice">@T["ToolsWorkerOffline"]</p>
}
@if (Model.FreshWorkers > 1)
{
    <p class="notice">@T["ToolsMultipleWorkers"]</p>
}
<div class="tools-grid">
    <section class="tool-card collector-card">
        <h2>@T["Tool_Collector"]</h2>
        <span class="tool-status @(workerFresh && !collectorFailed ? "tool-ready" : "tool-problem")">
            @(workerFresh ? (collectorFailed ? T["ToolState_Problem"] : T["ToolState_Ready"]) : T["ToolState_Unknown"])
        </span>
        <p>
            @(workerFresh ? (Model.Worker!.Collecting ? T["ToolsCollectorBusy"] : T["ToolsCollectorWaiting"]) : T["ToolsWorkerOffline"])
        </p>
        <dl class="tool-facts">
            <dt>@T["ToolsHeartbeatPalestine"]</dt>
            <dd>
                <bdi>@PalestineTime(Model.Worker?.At)</bdi>
            </dd>
            <dt>@T["ToolsWorker"]</dt>
            <dd>
                <bdi>@(Model.Worker is null ? "—" : Model.Worker.Host + " / " + Model.Worker.Account)</bdi>
            </dd>
            <dt>@T["ToolsLastLoopPalestine"]</dt>
            <dd>
                <bdi>@PalestineTime(Model.Worker?.LastLoopAt)</bdi>
            </dd>
            <dt>@T["ToolsQueue"]</dt>
            <dd>@Model.Waiting / @Model.Review</dd>
            <dt>@T["ToolsEnabledSources"]</dt>
            <dd>@Model.EnabledSources</dd>
        </dl>
        @if (collectorFailed)
        {
            <p>@T["ToolsErrorType"]: <bdi>@Model.Worker!.ErrorType</bdi></p>
            <p>@T["ToolHelp_Collector"]</p>
        }
        <div class="tool-card-actions">
            <form asp-controller="Tools" asp-action="CheckTool" method="get" data-tool-check><input type="hidden" name="tool" value="Collector" /><button type="submit" class="button-outline">@T["ToolsCheckSingle"]</button></form>
            <a class="button button-outline" asp-controller="Sources" asp-action="Sources">@T["Sources"]</a>
        </div>
    </section>
    @foreach (var key in ToolMonitoringRules.StandardTools.Append("AiLive"))
    {
        var result = Model.Results.FirstOrDefault(x => x.Tool == key);
        var fresh = result is not null && ToolMonitoringRules.ResultFresh(result, Model.ResultWorkers.GetValueOrDefault(result.WorkerId), Model.Now);
        if (key == "GoogleLogin" && Model.GoogleInteractive is { } interactive
            && (result is null || interactive.CheckedAt >= result.CheckedAt || result.State == ToolState.Configured))
        {
            result = interactive;
            fresh = true;
        }
        var state = fresh ? result!.State : ToolState.Unknown;
        <section class="tool-card" data-tool="@key">
            <h2>@T["Tool_" + key]</h2>
            <span class="tool-status @(state == ToolState.Ready ? "tool-ready" : state == ToolState.Problem || state == ToolState.NotConfigured ? "tool-problem" : "tool-neutral")">
                @T["ToolState_" + state]
            </span>
            @if (result is null)
            {
                <p>@T["ToolsNotChecked"]</p>
            }
            else
            {
                @if (!fresh)
                {
                    <p class="muted">@T["ToolsStale"]</p>
                }
                <p>@T["ToolCode_" + result.Code]</p>
                @if (!fresh)
                {
                    <p>@T["ToolsPreviousState"]: @T["ToolState_" + result.State]</p>
                }
                <dl class="tool-facts">
                    @if (result.Detail.Length > 0)
                    {
                        var detailLabel = result.State == ToolState.Problem ? "ToolsCheckDetails" : key switch
                        {
                            "AiConfiguration" => "ToolsModelName",
                            "Chromium" => "ToolsBrowserVersion",
                            "PdfText" or "PdfRender" or "PdfOcr" => "ToolsToolVersion",
                            "PdfLanguages" => "ToolsOcrLanguages",
                            "AiLive" => "ToolsHttpStatus",
                            "LahzaPayment" or "JawwalPayPayment" => "PaymentEnvironment",
                            _ => "ToolsCheckDetails"
                        };
                        <dt>@T[detailLabel]</dt>
                        <dd><bdi class="tool-detail">@(key is "LahzaPayment" or "JawwalPayPayment" ? T["PaymentEnvironment" + result.Detail] : result.Detail)</bdi></dd>
                    }
                    <dt>@T["ToolsCheckedAtPalestine"]</dt>
                    <dd><bdi>@PalestineTime(result.CheckedAt)</bdi></dd>
                    <dt>@T["ToolsCheckDuration"]</dt>
                    <dd><bdi>@result.DurationMs</bdi> @T["ToolsMilliseconds"]</dd>
                </dl>
            }
            <div class="tool-card-actions">
            @if (key == "GoogleLogin") {
                <form asp-controller="Integrations" asp-action="TestGoogle" method="get"><input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" /><button type="submit" class="button-outline">@T["GoogleTestLabel"]</button></form>
            } else {
            <form asp-controller="Tools" asp-action="CheckTool" method="get" data-tool-check><input type="hidden" name="tool" value="@key" /><button type="submit" class="button-outline">@T["ToolsCheckSingle"]</button></form>
            }
            @if (key is "GoogleLogin" or "Facebook" or "LinkedIn" or "LinkedInPersonal") {
                <a class="button button-outline" asp-controller="Integrations" asp-action="Index" asp-fragment="@(key == "GoogleLogin" ? "google-integration" : key.ToLowerInvariant() + "-integration")">@T["IntegrationSettings"]</a>
            }
            </div>
            @if (key == "GoogleLogin" && result?.Tool != "GoogleInteractive" && Model.GoogleInteractive is { } googleTest) {
                <p class="integration-test-result">@T["GoogleInteractiveReady"] <bdi>@PalestineTime(googleTest.CheckedAt)</bdi></p>
            }
            @if (key == "AiConfiguration" || key == "AiLive")
            {
                <a asp-controller="AiUsage" asp-action="AiUsage">@T["AiUsage"]</a>
            }
        </section>
    }
</div>
@if (Model.LastAi is { } ai)
{
    <section class="detail-panel">
        <h2>@T["ToolsLastAi"]</h2>
        <dl class="tool-facts">
            <dt>@T["ToolsModelName"]</dt>
            <dd><bdi>@ai.Model</bdi></dd>
            <dt>@T["ToolsCheckedAtPalestine"]</dt>
            <dd><bdi>@PalestineTime(ai.StartedAt)</bdi></dd>
            <dt>@T["Status"]</dt>
            <dd>@(ai.Success == true ? T["ToolsAiSucceeded"] : ai.Success == false ? T["ToolsAiFailed"] : T["ToolsAiUnfinished"])</dd>
            <dt>@T["ToolsHttpStatus"]</dt>
            <dd>@(ai.HttpStatus?.ToString() ?? "—")</dd>
            <dt>@T["ToolsAiTokens"]</dt>
            <dd>@(ai.TotalTokens?.ToString() ?? "—")</dd>
            @if (ai.ErrorType.Length > 0)
            {
                <dt>@T["ToolsErrorType"]</dt>
                <dd><bdi>@ai.ErrorType</bdi></dd>
            }
        </dl>
        <p class="muted">@T["ToolsLastAiNote"]</p>
    </section>
}
<section class="detail-panel">
    <h2>@T["ToolsRequests"]</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>@T["ToolsRequestKind"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["ToolsRequestedAt"]</th>
                    <th>@T["ToolsFinishedAt"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>@T["ToolKind_" + request.Kind]</td>
                        <td>
                            @T["ToolRequest_" + request.Status]
                            @if (request.Outcome.Length > 0)
                            {
                                <span>· @T["ToolOutcome_" + request.Outcome]</span>
                            }
                        </td>
                        <td>
                            <bdi>@PalestineTime(request.RequestedAt)</bdi>
                        </td>
                        <td>
                            <bdi>@PalestineTime(request.FinishedAt)</bdi>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<partial name="_AdminPagination" model="Model.RequestsPager" />
</div>
@section Scripts {
    <script src="~/js/tool-checks.js" asp-append-version="true" defer></script>
}

