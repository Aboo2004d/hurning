@model AdminPage<Source>
@{
    ViewData["Title"] = T["Sources"];
}
<div class="heading-row">
    <h1>@T["Sources"]</h1>
    <a class="button button-outline" asp-controller="Sources" asp-action="Source">@T["Add"]</a>
</div>
<p class="notice">@T["SourcesNote"]</p>
<p class="muted">@T["ScheduleZone"] · @T["CollectWorkerNote"]</p>
<div
    class="table-wrap"
    data-collection-pending="@(Model.Items.Any(s=>s.CollectionRequests.Any(r=>r.Status is "Pending" or "Running"))?"true":"false")"
>
    <table class="table-nowrap">
        <thead>
            <tr>
                <th>@T["Name"]</th>
                <th>@T["Enabled"]</th>
                <th>@T["StartTime"]</th>
                <th>@T["Interval"]</th>
                <th>@T["NextDue"]</th>
                <th>@T["CollectStatus"]</th>
                <th>@T["DiscoveryProgress"]</th>
                <th>@T["Error"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var source in Model.Items)
            {
                var request = source.CollectionRequests.FirstOrDefault();
                <tr>
                    <td>@source.Name</td>
                    <td>@T[source.Enabled?"Yes":"No"]</td>
                    <td>@source.CollectionStartTime.ToString("HH:mm")</td>
                    <td>@source.IntervalHours</td>
                    <td>@SourceSchedule.Display(source.NextDueAt)</td>
                    <td>@(request is null?T["Never"].Value:T["Request_"+request.Status].Value)</td>
                    <td>
                        @if (ViewBag.DiscoveryProgress is Dictionary<int, DiscoveryCheckpoint> progress && progress.TryGetValue(source.Id, out var cursor))
                        {
                            <span>@cursor.CompletedPages @T["SavedDiscoveryPages"] · @cursor.Found @T["Results"]</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>
                        <partial name="_Diagnostic" model="source.LastError"/>
                        @if (request is not null)
                        {
                            <partial name="_Diagnostic" model="request.Error"/>
                        }
                    </td>
                    <td>
                        <div class="source-actions">
                            <a class="button button-outline" asp-controller="Sources" asp-action="Source" asp-route-id="@source.Id">@T["Edit"]</a>
                            <form asp-controller="Sources" asp-action="CollectNow" method="post">
                                <input type="hidden" name="id" value="@source.Id"/>
                                <button
                                    class="button-outline"
                                    type="submit"
                                    disabled="@(!source.Enabled||!source.UsageApproved||request?.Status is "Pending" or "Running")"
                                >
                                    @T["CollectNow"]
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_AdminPagination" model="Model.Pager" />
