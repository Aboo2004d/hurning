@model AdminPage<AdminOpportunitySummaryDto>
@{
    ViewData["Title"] = T["Opportunities"];
}
<div class="heading-row">
    <h1>@T["Opportunities"]</h1>
    <a class="button button-outline" asp-controller="Opportunities" asp-action="Create">@T["Add"]</a>
</div>
<nav class="message-tabs" aria-label="@T["Status"]" id="opportunity-tabs">
@foreach (var state in new[] { PublicationStatus.Published, PublicationStatus.NeedsReview, PublicationStatus.Archived, PublicationStatus.Draft })
{
    var counts = ViewBag.Counts as Dictionary<PublicationStatus, int>;
    <a asp-action="Opportunities" asp-route-status="@state" asp-route-page="1" class="@(ViewBag.Status == state ? "is-current" : null)" aria-current="@(ViewBag.Status == state ? "page" : null)">@T[state.ToString()] (<span data-tab-total="@state">@(counts?.GetValueOrDefault(state) ?? 0)</span>)</a>
}
</nav>
<p id="opportunity-load-error" class="notice" role="alert" hidden>@T["LoadFailed"]</p>
<div id="opportunity-results" aria-live="polite"><partial name="/Areas/Admin/Views/Opportunities/_OpportunityRows.cshtml" model="Model" /></div>
<script src="~/js/opportunity-tabs.js" asp-append-version="true" defer></script>
