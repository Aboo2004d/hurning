@model TelegramMemberSetting
@{ ViewData["Title"] = T["TelegramMemberTools"].Value; }
<header class="admin-page-heading"><h1>@ViewData["Title"]</h1><a class="button" asp-action="Compose">@T["TelegramMemberCompose"]</a></header>
<form asp-action="Settings" method="post" class="membership-card">
    <h2>@T["TelegramMemberSearch"]</h2>
    <label class="check"><input asp-for="SearchEnabled" />@T["Enabled"]</label>
    <label>@T["TelegramMemberAudience"]<select asp-for="PaidOnly"><option value="false">@T["TelegramMemberAll"]</option><option value="true">@T["TelegramMemberPaid"]</option></select></label>
    <p>@T["TelegramMemberCriteria"]</p>
    <label class="check"><input asp-for="CityEnabled" />@T["City"]</label>
    <label class="check"><input asp-for="OrganizationEnabled" />@T["Organization"]</label>
    <label class="check"><input asp-for="CategoryEnabled" />@T["Category"]</label>
    <button type="submit">@T["Save"]</button>
    <p class="muted">@T["TelegramMemberSearchHelp"]</p>
    <pre dir="ltr">/jobs</pre>
    <p>@T["TelegramMemberButtonsSetup"] <a asp-controller="TelegramBot" asp-action="Index">@T["TelegramBotSetup"]</a></p>
</form>
<h2>@T["TelegramMemberHistory"]</h2>
<p>@T["TelegramMemberDeliveryNote"] <a asp-controller="Notifications" asp-action="Index">@T["NotificationDelivery"]</a></p>
@if (ViewBag.Broadcasts is List<TelegramMemberBroadcast> broadcasts)
{
    <div class="table-wrap"><table><thead><tr><th>@T["CreatedPalestineTime"]</th><th>@T["Administrator"]</th><th>@T["TelegramMemberAudience"]</th><th>@T["Message"]</th><th>@T["Status"]</th></tr></thead><tbody>
    @foreach (var item in broadcasts)
    { <tr><td>@SourceSchedule.Display(item.CreatedAt)</td><td>@item.Actor</td><td>@T[item.PaidOnly ? "TelegramMemberPaid" : "TelegramMemberAll"]</td><td style="white-space:pre-wrap">@item.Body</td><td>@T[item.Completed ? "TelegramMemberExpanded" : "TelegramMemberExpanding"]</td></tr> }
    </tbody></table></div>
}
