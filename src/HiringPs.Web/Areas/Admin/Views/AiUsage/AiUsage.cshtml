@model AiUsageDashboard
@{
    ViewData["Title"] = T["AiUsage"];
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<h1>@T["AiUsage"]</h1>
<p class="notice">
    @(ar ? "النجاح يعني قراءة استجابة AI، وليس اعتماد الإعلان للنشر. علامة — تعني أن المزود لم يعِد العدد؛ المجاميع تشمل الأعداد المعروفة فقط. الطلب غير المكتمل قد يكون توقف معه العامل." : "Success means the AI response was parsed, not that publication was approved. — means no token count was reported; totals cover known counts only. Unfinished requests may reflect an interrupted worker.")
</p>
<form method="get" class="ai-usage-filter">
    <label>
        @(ar ? "آخر عدد أيام" : "Last days")
        <input name="days" value="@Model.Days" type="number" min="1" max="365" required dir="ltr" />
    </label>
    <button type="submit">@T["Filters"]</button>
</form>
<div id="ai-totals" class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>@(ar ? "نسخة البرومبت / النموذج" : "Prompt / model")</th>
                <th>@(ar ? "الطلبات" : "Requests")</th>
                <th>@(ar ? "نجح / فشل / غير مكتمل" : "Success / failed / unfinished")</th>
                <th>@(ar ? "توكنز الإدخال / الإخراج / المجموع" : "Input / output / total tokens")</th>
                <th>@(ar ? "طلبات دون عدد توكنز" : "Requests with unknown tokens")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model.Groups)
            {
                <tr>
                    <td>
                        <a asp-controller="AiPrompt" asp-action="AiPrompt" asp-route-inspect="@group.PromptVersionId">#@group.PromptVersionId</a>
                        · @group.Model
                    </td>
                    <td>@group.Requests</td>
                    <td>@group.Succeeded / @group.Failed / @group.Unfinished</td>
                    <td>
                        @(group.InputTokens?.ToString() ?? "—") / @(group.OutputTokens?.ToString() ?? "—") / @(group.TotalTokens?.ToString() ?? "—")
                    </td>
                    <td>@group.UnknownTokenRequests</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_AdminPagination" model="Model.GroupsPager" />
<div id="ai-requests" class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>@(ar ? "المحتوى" : "Item")</th>
                <th>@(ar ? "النسخة / النموذج" : "Version / model")</th>
                <th>@(ar ? "الحالة / HTTP" : "Outcome / HTTP")</th>
                <th>@(ar ? "التوكنز" : "Tokens")</th>
                <th>@(ar ? "المدة" : "Duration")</th>
                <th>@(ar ? "الوقت" : "Time")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        @if (item.SourceItemId is { } sourceId)
                        {
                            <a asp-controller="Items" asp-action="Item" asp-route-id="@sourceId">@sourceId</a>
                        }
                    </td>
                    <td>@item.PromptVersionId · @item.Model</td>
                    <td>
                        @(item.Success is null ? (ar ? "غير مكتمل" : "Unfinished") : item.Success == true ? (ar ? "نجاح" : "Success") : item.ErrorType) · @item.HttpStatus
                    </td>
                    <td>@(item.TotalTokens?.ToString() ?? "—")</td>
                    <td>@item.DurationMs ms</td>
                    <td>@item.StartedAt.ToString("u")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_AdminPagination" model="Model.ItemsPager" />
