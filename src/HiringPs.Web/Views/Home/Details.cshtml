@model Opportunity
@{ViewData["Title"]=Model.Title;ViewData["Description"]=Model.Summary;var expired=Model.Status==PublicationStatus.Archived||(Model.Deadline is {} d&&d<TextRules.PalestineToday());var sourceUrl=Model.SourceLinks.FirstOrDefault()?.SourceItem.Url;}
<a class="textlink" asp-action="Index">→ @T["Back"]</a><article class="detail-panel"><div class="card-top"><span dir="auto">@Model.Organization</span><span class="badge">@T[Model.Kind.ToString()]</span></div><h1 dir="auto" lang="@Model.OriginalLanguage">@Model.Title</h1>@if(expired){<div class="notice">@T["Expired"]</div>}<dl class="detail-grid"><div><dt>@T["Location"]</dt><dd dir="auto">@Model.Locations</dd></div><div><dt>@T["Category"]</dt><dd dir="auto">@Model.Category</dd></div><div><dt>@T["Deadline"]</dt><dd>@(Model.Deadline?.ToString("yyyy-MM-dd")??T["UnknownDeadline"].Value)</dd></div><div><dt>@T["Verified"]</dt><dd>@Model.LastVerifiedAt.ToString("yyyy-MM-dd")</dd></div>@if(Model.Kind==OpportunityKind.Job){<div><dt>@T["Employment"]</dt><dd>@Model.EmploymentType</dd></div><div><dt>@T["Experience"]</dt><dd>@Model.ExperienceLevel</dd></div>}else if(Model.Kind==OpportunityKind.Training){<div><dt>@T["Duration"]</dt><dd>@Model.Duration</dd></div><div><dt>@T["Cost"]</dt><dd>@Model.Cost</dd></div>}else{<div><dt>@T["Reference"]</dt><dd dir="auto">@Model.ReferenceNumber</dd></div>}@if(Model.Eligibility.Length>0){<div><dt>@T["Eligibility"]</dt><dd dir="auto">@Model.Eligibility</dd></div>}</dl><h2>@T["Summary"]</h2><p dir="auto" lang="@Model.OriginalLanguage">@Model.Summary</p><p class="muted">@T["SummaryNote"]</p>
<div class="actions">@if(!expired&&Model.ApplyUrl.Length>0){<a class="button" href="@Model.ApplyUrl" rel="noopener noreferrer">@T["Original"]</a>}else if(sourceUrl is not null){<a class="button" href="@sourceUrl" rel="noopener noreferrer">@T["Source"]</a>}</div><div class="sources">@foreach(var link in Model.SourceLinks){<a href="@link.SourceItem.Url" rel="noopener noreferrer">@link.SourceItem.Source.Name</a>}</div>
@{var files=System.Text.Json.JsonSerializer.Deserialize<string[]>(Model.AttachmentsJson)??[];}
@if(files.Length>0){<div class="sources">@foreach(var file in files){if(Uri.TryCreate(file,UriKind.Absolute,out var fileUri)&&fileUri.Scheme=="https"){<a href="@file" rel="noopener noreferrer">@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"?"وثيقة الإعلان":"Listing attachment")</a>}}</div>}
<details class="report-panel"><summary>@T["Report"]</summary><form asp-action="Report" method="post"><input type="hidden" name="id" value="@Model.Id"/><label>@T["ReportReason"]<select name="reason">@foreach(var value in new[]{"expired","duplicate","incorrect","broken","other"}){<option value="@value">@T[value=="expired"?"Report_expired":value]</option>}</select></label><label>@T["ReportDetails"]<textarea name="details" maxlength="1000" rows="3"></textarea></label><button type="submit">@T["Send"]</button></form></details></article>
