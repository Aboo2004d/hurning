@model ListingModel
@* صفحة قائمة الفرص: العنوان والبحث والفلاتر والبطاقات ثم التنقل بين الصفحات. *@
@{
    var kindHeading = Model.Kind == OpportunityKind.Job ? "Jobs" : Model.Kind?.ToString() ?? "Headline";
    var heading = Model.Archive ? T["Archive"].Value + (Model.Kind is null ? "" : " · " + T[kindHeading].Value) : T[kindHeading].Value;
    var subtitle = Model.Kind is null ? "Subtitle" : Model.Kind + "Subtitle";
    ViewData["Title"] = heading;
    ViewData["Description"] = T[subtitle].Value;
}
<section class="intro">
    <h1>@heading</h1>
    <p>@T[subtitle]</p>
</section>
<form method="get" asp-action="Index" id="listing-form">
    <input type="hidden" name="archive" value="@Model.Archive.ToString().ToLowerInvariant()"/>
    <input type="hidden" name="kind" value="@Model.Kind"/>
    <div class="searchbar">
        <input type="search" name="q" value="@Model.Query" placeholder="@T["SearchPlaceholder"]" aria-label="@T["Search"]"/>
        <button type="submit">@T["Search"]</button>
    </div>
    <div class="listing-layout">
        <aside class="filter-panel">
            <details open>
                <summary>@T["Filters"]</summary>
                <label>
                    @T["Location"]
                    <select name="city">
                        <option value="">@T["All"]</option>
                        @foreach (var city in Model.Cities)
                        {
                            <option selected="@(Model.City==city)" value="@city">@city</option>
                        }
                    </select>
                </label>
                <label>
                    @T["Category"]
                    <select name="category">
                        <option value="">@T["All"]</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option selected="@(Model.Category==category)">@category</option>
                        }
                    </select>
                </label>
                <div id="employment-filters" hidden="@(Model.Kind!=OpportunityKind.Job)">
                    <label>
                        @T["Employment"]
                        <select name="employment">
                            <option value="">@T["All"]</option>
                            @foreach (var value in Model.EmploymentTypes)
                            {
                                <option selected="@(Model.Employment==value)">@value</option>
                            }
                        </select>
                    </label>
                    <label>
                        @T["Experience"]
                        <select name="experience">
                            <option value="">@T["All"]</option>
                            @foreach (var value in Model.ExperienceLevels)
                            {
                                <option selected="@(Model.Experience==value)">@value</option>
                            }
                        </select>
                    </label>
                </div>
                <button type="submit">@T["Filters"]</button>
                <a class="textlink" asp-action="Index" asp-route-kind="@Model.Kind" asp-route-archive="@Model.Archive">
                    @T["Clear"]
                </a>
            </details>
        </aside>
        <section>
            <div class="results-header">
                <strong>@Model.Count @T["Results"]</strong>
                <span>@T["Newest"]</span>
            </div>
            <div class="opportunity-grid">
                @if (Model.Items.Count == 0)
                {
                    <div class="empty-state">@T["Empty"]</div>
                }
                @foreach (var item in Model.Items)
                {
                    <a class="opportunity-card" asp-action="Details" asp-route-id="@item.Id">
                        <div class="card-top">
                            <span class="organization" dir="auto">@item.Organization</span>
                            <span class="badge">@T[item.Kind.ToString()]</span>
                        </div>
                        <h2 dir="@(item.OriginalLanguage=="ar"?"rtl":"ltr")" lang="@item.OriginalLanguage">@item.Title</h2>
                        <p class="metadata" dir="auto">
                            @item.Locations
                            @if (item.Kind == OpportunityKind.Job && item.EmploymentType.Length > 0)
                            {
                                <span> · @item.EmploymentType</span>
                            }
                        </p>
                        <p class="summary" dir="@(item.OriginalLanguage=="ar"?"rtl":"ltr")" lang="@item.OriginalLanguage">
                            @item.Summary
                        </p>
                        <div class="tags">
                            @if (item.Category.Length > 0)
                            {
                                <span>@item.Category</span>
                            }
                            @if (item.ReferenceNumber.Length > 0)
                            {
                                <span dir="auto">@item.ReferenceNumber</span>
                            }
                        </div>
                        <div class="card-bottom">
                            <span>
                                @(Model.Archive?T["Expired"]:item.Deadline is {} deadline?T["Deadline"]+": "+deadline.ToString("yyyy-MM-dd"):T["UnknownDeadline"])
                            </span>
                            <strong>@T["Details"] ←</strong>
                        </div>
                    </a>
                }
            </div>
            <nav class="pagination" aria-label="Pagination">
                @if (Model.Page > 1)
                {
                    <a asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Query" asp-route-kind="@Model.Kind" asp-route-city="@Model.City" asp-route-category="@Model.Category" asp-route-employment="@Model.Employment" asp-route-experience="@Model.Experience" asp-route-archive="@Model.Archive">
                        @T["Previous"]
                    </a>
                }
                <span>@Model.Page / @Math.Max(1,(Model.Count+11)/12)</span>
                @if (Model.Page * 12 < Model.Count)
                {
                    <a asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Query" asp-route-kind="@Model.Kind" asp-route-city="@Model.City" asp-route-category="@Model.Category" asp-route-employment="@Model.Employment" asp-route-experience="@Model.Experience" asp-route-archive="@Model.Archive">
                        @T["Next"]
                    </a>
                }
            </nav>
        </section>
    </div>
</form>
