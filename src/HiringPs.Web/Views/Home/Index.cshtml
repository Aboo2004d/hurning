@model ListingModel
@* صفحة قائمة الفرص: العنوان وما يغلق هذا الأسبوع والبحث والفلاتر والترتيب والبطاقات ثم الترقيم وروابط التصفح. *@
@{
    var english = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    var kindHeading = Model.Kind == OpportunityKind.Job ? "Jobs" : Model.Kind?.ToString() ?? "Headline";
    var heading = Model.Archive ? T["Archive"].Value + (Model.Kind is null ? "" : " · " + T[kindHeading].Value) : T[kindHeading].Value;
    var subtitle = Model.Kind is null ? "Subtitle" : Model.Kind + "Subtitle";
    ViewData["Title"] = heading;
    ViewData["Description"] = T[subtitle].Value;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var member = signedIn && !User.IsInRole("Admin");
    var currentUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var facets = ViewBag.Facets as BrowseFacets;
    var stats = ViewBag.Stats as HomeStatsDto;
    string ListingUrl(int page, string? sort = null)
    {
        var values = Model.RouteValues(page);
        if (sort is not null)
        {
            values.Remove("sort");
            if (sort != ListingSort.Newest)
                values["sort"] = sort;
        }
        return Url.Action("Index", "Home", values.ToDictionary(x => x.Key, x => (object?)x.Value))!;
    }
}
<section class="intro hero @(Model.Kind is null && !Model.Archive ? "hero-home" : null)">
    <div class="hero-text">
        <h1>@heading</h1>
        <p>@T[subtitle]</p>
    </div>
    <div class="hero-search" role="search">
        <span class="fa-solid fa-magnifying-glass" aria-hidden="true"></span>
        <label class="visually-hidden" for="listing-query">@T["Search"]</label>
        <input id="listing-query" type="search" name="q" value="@Model.Query" form="listing-form"
               placeholder="@T["SearchPlaceholder"]" />
        <button class="button" type="submit" form="listing-form">@T["Search"]</button>
    </div>
    @if (stats is not null)
    {
        <nav class="kind-tabs" aria-label="@T["OpportunityTypes"]">
            <a href="@Url.Action("Index", "Home", new { archive = Model.Archive ? "true" : null })"
               aria-current="@(Model.Kind is null ? "page" : null)">
                <span>@T["AllOpportunities"]</span>
                <span class="kind-count">@stats.Total</span>
            </a>
            @foreach (var kind in Enum.GetValues<OpportunityKind>())
            {
                <a class="kind-@kind.ToString().ToLowerInvariant()" href="@Url.Action("Index", "Home", new { kind })"
                   aria-current="@(Model.Kind == kind ? "page" : null)">
                    <span class="kind-dot" aria-hidden="true"></span>
                    <span>@T[kind == OpportunityKind.Job ? "Jobs" : kind.ToString()]</span>
                    <span class="kind-count">@stats.Count(kind)</span>
                </a>
            }
        </nav>
        @if (Model.Kind is null)
        {
            <ul class="hero-stats">
                <li><strong>@stats.Total</strong> @T["StatOpenOpportunities"]</li>
                <li><strong>@stats.Organizations</strong> @T["StatOrganizations"]</li>
                @if (stats.NewToday > 0)
                {
                    <li><strong>@stats.NewToday</strong> @T["StatNewToday"]</li>
                }
            </ul>
        }
    }
</section>
<partial name="/Views/Home/_ClosingWeek.cshtml" model="Model" />
<form method="get" asp-action="Index" id="listing-form">
    @if (Model.Archive)
    {
        <input type="hidden" name="archive" value="true"/>
    }
    @if (Model.Kind is not null)
    {
        <input type="hidden" name="kind" value="@Model.Kind"/>
    }
    @if (Model.Sort != ListingSort.Newest)
    {
        <input type="hidden" name="sort" value="@Model.Sort"/>
    }
    <div class="listing-layout">
        <aside class="filter-panel">
            <details open>
                <summary>@T["Filters"]</summary>
                <label>
                    @T["Location"]
                    <select name="city">
                        <option value="">@T["All"]</option>
                        @foreach (var city in Model.Cities)
                        {
                            <option selected="@(Model.City == city.Value)" value="@city.Value">@city.Label</option>
                        }
                    </select>
                </label>
                <label>
                    @T["Category"]
                    <select name="category">
                        <option value="">@T["All"]</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option selected="@(FilterLabels.Category(Model.Category, english) == category.Label)" value="@category.Value">@category.Label</option>
                        }
                    </select>
                </label>
                <div id="employment-filters" hidden="@(Model.Kind!=OpportunityKind.Job)">
                    <label>
                        @T["Employment"]
                        <select name="employment">
                            <option value="">@T["All"]</option>
                            @foreach (var value in Model.EmploymentTypes)
                            {
                                <option selected="@(FilterLabels.Employment(Model.Employment, english) == value.Label)" value="@value.Value">@value.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        @T["Experience"]
                        <select name="experience">
                            <option value="">@T["All"]</option>
                            @foreach (var value in Model.ExperienceLevels)
                            {
                                <option selected="@(FilterLabels.Experience(Model.Experience, english) == value.Label)" value="@value.Value">@value.Label</option>
                            }
                        </select>
                    </label>
                </div>
                <div class="listing-filter-actions">
                    <button class="button button-outline listing-action" type="submit">
                        <span class="fa-solid fa-filter" aria-hidden="true"></span>
                        <span>@T["Filters"]</span>
                    </button>
                    <a class="button button-outline listing-action" asp-action="Index" asp-route-kind="@Model.Kind" asp-route-archive="@(Model.Archive ? "true" : null)">
                        <span class="fa-solid fa-rotate-right" aria-hidden="true"></span>
                        <span>@T["Clear"]</span>
                    </a>
                </div>
            </details>
        </aside>
        <section>
            <div class="results-header">
                <strong>@Model.Count @T["Results"]</strong>
                <a class="textlink feed-link" type="application/rss+xml" href="@((Context.Items["MountPath"] is PathString mount ? mount.Value : "") + FeedLinks.ForListing(Model))"><i class="fa-solid fa-rss" aria-hidden="true"></i> @T["RssFeed"]</a>
                <nav class="sort-links" aria-label="@T["SortBy"]">
                    <span class="sort-label" aria-hidden="true">@T["SortBy"]:</span>
                    <a href="@ListingUrl(1, ListingSort.Newest)" aria-current="@(Model.Sort == ListingSort.Newest ? "true" : null)">@T["Newest"]</a>
                    <a href="@ListingUrl(1, ListingSort.Closing)" aria-current="@(Model.Sort == ListingSort.Closing ? "true" : null)">@T["SortClosing"]</a>
                </nav>
            </div>
            @if (Model.CanAlert && !User.IsInRole("Admin"))
            {
                <div class="alert-search" data-alert-search>
                    @if (member)
                    {
                        <button class="button button-outline listing-action" type="submit" form="alert-search-form"
                                data-saved-text="@T["AlertSearchSaved"]" data-error-text="@T["AlertSearchFailed"]">
                            <span class="fa-solid fa-bell" aria-hidden="true"></span>
                            <span>@T["AlertSearch"]</span>
                        </button>
                    }
                    else
                    {
                        <a class="button button-outline listing-action" asp-controller="Registration" asp-action="Index">
                            <span class="fa-solid fa-bell" aria-hidden="true"></span>
                            <span>@T["AlertSearch"]</span>
                        </a>
                        <a class="textlink" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@currentUrl">@T["HaveAccountLogin"]</a>
                    }
                    <p class="muted alert-search-hint">@T["AlertSearchHint"]</p>
                    <p class="save-feedback" data-alert-feedback role="status" hidden></p>
                </div>
            }
            <partial name="_OpportunityCards" model="new CardListModel(Model, Model.Items)" />
            <partial name="_Pagination" model="new PaginationModel(Model.Page, Model.PageCount, page => ListingUrl(page))" />
        </section>
    </div>
</form>

@if (facets is not null)
{
    var cities = facets.Cities.Where(x => Model.Kind is null || x.Kind == Model.Kind).Take(12).ToList();
    var organizations = facets.Organizations.Take(12).ToList();
    @if (cities.Count > 0 || organizations.Count > 0)
    {
        <section class="browse-links" aria-label="@T["BrowseOpportunities"]">
            @if (cities.Count > 0)
            {
                <div>
                    <h2><span class="fa-solid fa-city" aria-hidden="true"></span>@T["BrowseByCity"]</h2>
                    <ul>
                        @foreach (var facet in cities)
                        {
                            var kindLabel = T[facet.Kind == OpportunityKind.Job ? "Jobs" : facet.Kind.ToString()].Value;
                            <li>
                                <a class="chip kind-@facet.Kind.ToString().ToLowerInvariant()" href="@Url.Content("~" + HiringPs.Web.Controllers.BrowsePaths.City(facet.Kind, facet.City))">
                                    <span class="kind-dot" aria-hidden="true"></span>
                                    <span>@string.Format(CultureInfo.CurrentCulture, T["BrowseCityHeading"].Value, kindLabel, facet.City.Name(english))</span>
                                    <span class="chip-count">@facet.Count</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (organizations.Count > 0)
            {
                <div>
                    <h2><span class="fa-solid fa-building" aria-hidden="true"></span>@T["BrowseByOrganization"]</h2>
                    <ul>
                        @foreach (var organization in organizations)
                        {
                            <li>
                                <a class="chip" href="@Url.Content("~" + HiringPs.Web.Controllers.BrowsePaths.Organization(organization.Slug))">
                                    <span dir="auto">@organization.Name</span>
                                    <span class="chip-count">@organization.Count</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>
    }
}

@if (member)
{
    @if (Model.CanAlert)
    {
        <form id="alert-search-form" asp-area="Member" asp-controller="Preferences" asp-action="AddSearch" method="post" data-alert-search-form>
            <input type="hidden" name="kind" value="@Model.Kind" />
            <input type="hidden" name="city" value="@Model.City" />
            <input type="hidden" name="category" value="@Model.Category" />
            <input type="hidden" name="returnUrl" value="@currentUrl" />
        </form>
    }
    @foreach (var item in Model.Items)
    {
        <form id="save-@item.Id" asp-area="Member" asp-controller="Saved" asp-action="Add" method="post" data-save-opportunity>
            <input type="hidden" name="returnUrl" value="@currentUrl" />
            <input type="hidden" name="id" value="@item.Id" />
        </form>
    }
}
