@model HiringPs.Web.Controllers.AdminDashboard
@{ViewData["Title"]=T["Dashboard"];}
<partial name="_AdminNav"/><h1>@T["Dashboard"]</h1><div class="metrics"><div><span>@T["Published"]</span><strong>@Model.Published</strong></div><div><span>@T["Review"]</span><strong>@Model.Review</strong></div><div><span>@T["Queue"]</span><strong>@Model.Queued</strong></div><div><span>@T["Reports"]</span><strong>@Model.Reports</strong></div></div><p class="notice">@T["Worker"]: @(Model.Heartbeat is null?T["Never"].Value:$"{Model.Heartbeat.State} · {Model.Heartbeat.At:yyyy-MM-dd HH:mm} UTC")</p><h2>@T["Runs"]</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>@T["Source"]</th><th>@T["Started"]</th><th>@T["Status"]</th><th>@T["Found"]</th><th>@T["Changed"]</th><th>@T["Error"]</th></tr></thead><tbody>@foreach(var run in Model.Runs){<tr><td>@run.Id</td><td>@run.SourceId</td><td>@run.StartedAt.ToString("yyyy-MM-dd HH:mm") UTC</td><td>@run.Status</td><td>@run.Found</td><td>@run.Changed</td><td>@run.Error</td></tr>}</tbody></table></div><h2>@T["Queue"]</h2><div class="table-wrap"><table><thead><tr><th>@T["Source"]</th><th>@T["Status"]</th><th>@T["Error"]</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Source.Name · @item.ExternalId</td><td>@item.Status</td><td>@item.Error</td><td><a asp-action="Item" asp-route-id="@item.Id">@T["Details"]</a></td></tr>}</tbody></table></div>
