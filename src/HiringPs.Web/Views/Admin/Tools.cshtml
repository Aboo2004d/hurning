@model ToolDashboard
@{
    ViewData["Title"] = T["Tools"];
    var workerFresh = ToolMonitoringRules.WorkerFresh(Model.Worker, Model.Now);
    var collectorFailed = Model.Worker?.LastFailureAt is { } failure && (Model.Worker.LastSuccessAt is null || failure > Model.Worker.LastSuccessAt);
}
<h1>@T["Tools"]</h1>
<p class="notice">@T["ToolsIntro"]</p>
<div class="actions tools-actions">
    <form asp-action="CheckTools" method="post">
        <button type="submit">@T["ToolsCheckNow"]</button>
    </form>
    <form asp-action="CheckAi" method="post">
        <button type="submit" class="button-outline">@T["ToolsCheckAi"]</button>
    </form>
    <a class="button button-outline" asp-action="Tools">@T["ToolsRefresh"]</a>
</div>
<p class="muted">@T["ToolsAiCost"]</p>
@if (!workerFresh)
{
    <p class="notice">@T["ToolsWorkerOffline"]</p>
}
@if (Model.FreshWorkers > 1)
{
    <p class="notice">@T["ToolsMultipleWorkers"]</p>
}
<div class="tools-grid">
    <section class="tool-card">
        <h2>@T["Tool_Collector"]</h2>
        <span class="tool-status @(workerFresh && !collectorFailed ? "tool-ready" : "tool-problem")">
            @(workerFresh ? (collectorFailed ? T["ToolState_Problem"] : T["ToolState_Ready"]) : T["ToolState_Unknown"])
        </span>
        <p>
            @(workerFresh ? (Model.Worker!.Collecting ? T["ToolsCollectorBusy"] : T["ToolsCollectorWaiting"]) : T["ToolsWorkerOffline"])
        </p>
        <dl class="tool-facts">
            <dt>@T["ToolsHeartbeatUtc"]</dt>
            <dd>
                <bdi>@(Model.Worker?.At.ToString("u") ?? "—")</bdi>
            </dd>
            <dt>@T["ToolsWorker"]</dt>
            <dd>
                <bdi>@(Model.Worker is null ? "—" : Model.Worker.Host + " / " + Model.Worker.Account)</bdi>
            </dd>
            <dt>@T["ToolsLastLoopUtc"]</dt>
            <dd>
                <bdi>@(Model.Worker?.LastLoopAt?.ToString("u") ?? "—")</bdi>
            </dd>
            <dt>@T["ToolsQueue"]</dt>
            <dd>@Model.Waiting / @Model.Review</dd>
            <dt>@T["ToolsEnabledSources"]</dt>
            <dd>@Model.EnabledSources</dd>
        </dl>
        @if (collectorFailed)
        {
            <p>@T["ToolsErrorType"]: <bdi>@Model.Worker!.ErrorType</bdi></p>
            <p>@T["ToolHelp_Collector"]</p>
        }
        <a asp-action="Sources">@T["Sources"]</a>
    </section>
    @foreach (var key in ToolMonitoringRules.StandardTools.Append("AiLive"))
    {
        var result = Model.Results.FirstOrDefault(x => x.Tool == key);
        var fresh = result is not null && ToolMonitoringRules.ResultFresh(result, Model.Worker, Model.Now);
        var state = fresh ? result!.State : ToolState.Unknown;
        <section class="tool-card">
            <h2>@T["Tool_" + key]</h2>
            <span class="tool-status @(state == ToolState.Ready ? "tool-ready" : state == ToolState.Problem || state == ToolState.NotConfigured ? "tool-problem" : "tool-neutral")">
                @T["ToolState_" + state]
            </span>
            @if (result is null)
            {
                <p>@T["ToolsNotChecked"]</p>
            }
            else
            {
                @if (!fresh)
                {
                    <p class="muted">@T["ToolsStale"]</p>
                }
                <p>@T["ToolCode_" + result.Code]</p>
                @if (!fresh)
                {
                    <p>@T["ToolsPreviousState"]: @T["ToolState_" + result.State]</p>
                }
                <dl class="tool-facts">
                    @if (result.Detail.Length > 0)
                    {
                        var detailLabel = key switch
                        {
                            "AiConfiguration" => "ToolsModelName",
                            "Chromium" => "ToolsBrowserVersion",
                            "PdfText" or "PdfRender" or "PdfOcr" => "ToolsToolVersion",
                            "PdfLanguages" => "ToolsOcrLanguages",
                            "AiLive" => "ToolsHttpStatus",
                            _ => "ToolsCheckDetails"
                        };
                        <dt>@T[detailLabel]</dt>
                        <dd><bdi class="tool-detail">@result.Detail</bdi></dd>
                    }
                    <dt>@T["ToolsCheckedAtUtc"]</dt>
                    <dd><bdi>@result.CheckedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</bdi></dd>
                    <dt>@T["ToolsCheckDuration"]</dt>
                    <dd><bdi>@result.DurationMs</bdi> @T["ToolsMilliseconds"]</dd>
                </dl>
            }
            @if (key == "AiConfiguration" || key == "AiLive")
            {
                <a asp-action="AiUsage">@T["AiUsage"]</a>
            }
        </section>
    }
</div>
@if (Model.LastAi is { } ai)
{
    <section class="detail-panel">
        <h2>@T["ToolsLastAi"]</h2>
        <dl class="tool-facts">
            <dt>@T["ToolsModelName"]</dt>
            <dd><bdi>@ai.Model</bdi></dd>
            <dt>@T["ToolsCheckedAtUtc"]</dt>
            <dd><bdi>@ai.StartedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</bdi></dd>
            <dt>@T["Status"]</dt>
            <dd>@(ai.Success == true ? T["ToolsAiSucceeded"] : ai.Success == false ? T["ToolsAiFailed"] : T["ToolsAiUnfinished"])</dd>
            <dt>@T["ToolsHttpStatus"]</dt>
            <dd>@(ai.HttpStatus?.ToString() ?? "—")</dd>
            <dt>@T["ToolsAiTokens"]</dt>
            <dd>@(ai.TotalTokens?.ToString() ?? "—")</dd>
            @if (ai.ErrorType.Length > 0)
            {
                <dt>@T["ToolsErrorType"]</dt>
                <dd><bdi>@ai.ErrorType</bdi></dd>
            }
        </dl>
        <p class="muted">@T["ToolsLastAiNote"]</p>
    </section>
}
<section class="detail-panel">
    <h2>@T["ToolsRequests"]</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>@T["ToolsRequestKind"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["ToolsRequestedAt"]</th>
                    <th>@T["ToolsFinishedAt"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>@T["ToolKind_" + request.Kind]</td>
                        <td>
                            @T["ToolRequest_" + request.Status]
                            @if (request.Outcome.Length > 0)
                            {
                                <span>· @T["ToolOutcome_" + request.Outcome]</span>
                            }
                        </td>
                        <td>
                            <bdi>@request.RequestedAt.ToString("u")</bdi>
                        </td>
                        <td>
                            <bdi>@(request.FinishedAt?.ToString("u") ?? "—")</bdi>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<partial name="_AdminPagination" model="Model.RequestsPager" />
