@model Source
@{
    ViewData["Title"] = T["Source"];
}
<h1>@T["Source"]</h1>
<section class="edit-form source-setup" data-source-setup>
    <h2>@T["SourceSetupTitle"]</h2>
    <p class="muted">@T["SourceSetupIntro"]</p>
    <form asp-action="SuggestSource" method="post" data-setup-form>
        <input type="hidden" name="sourceId" value="@Model.Id" />
        <label for="source-setup-url">@T["SourceSetupWebsite"]</label>
        <div class="source-setup-input">
            <input id="source-setup-url" name="url" type="url" value="@Model.Url" dir="ltr" maxlength="1000" required placeholder="https://example.ps" />
            <button type="submit" data-setup-submit>@T["SourceSetupSuggest"]</button>
        </div>
        <p class="muted">@T["SourceSetupCost"]</p>
    </form>
    <p role="status" aria-live="polite" data-setup-status
       data-loading="@T["SourceSetupLoading"]" data-ready="@T["SourceSetupReady"]"
       data-applied="@T["SourceSetupApplied"]" data-failed="@T["SourceSetupFailed"]"></p>
    <div hidden data-setup-result>
        <p data-setup-explanation></p>
        <dl class="tool-facts">
            <dt>@T["Url"]</dt><dd><bdi data-setup-listing></bdi></dd>
            <dt>@T["Connector"]</dt><dd data-setup-connector></dd>
            <dt>@T["SourceSetupNext"]</dt><dd><bdi data-setup-next></bdi></dd>
        </dl>
        <h3>@T["SourceSetupSamples"]</h3>
        <ul class="source-setup-links" data-setup-links></ul>
        <details>
            <summary>@T["SourceSetupSampleText"]</summary>
            <pre dir="auto" data-setup-text></pre>
        </details>
        <details>
            <summary>@T["Config"]</summary>
            <pre dir="ltr" data-setup-config></pre>
        </details>
        <p class="muted">@T["SourceSetupLimit"]</p>
        <button class="button-outline" type="button" data-setup-apply>@T["SourceSetupApply"]</button>
    </div>
    <div hidden data-setup-errors>
        @foreach (var key in new[]
        {
            "SourceSetupStageConfiguration", "SourceSetupStageRead", "SourceSetupStageAi", "SourceSetupStageListing", "SourceSetupStagePreview",
            "SourceSetupHttpFailed", "SourceSetupRequestReference", "SourceSetupNetworkFailed", "SourceSetupSampleInvalid", "SourceSetupBrowserFailed",
            "SourceSetupDuplicate", "SourceSetupInvalidUrl", "SourceSetupSocialDeferred", "SourceSetupUnsupported", "SourceSetupUnseenUrl",
            "SourceSetupInvalidReply", "SourceSetupNoLinks", "SourceSetupPageTooLarge", "SourceSetupInteractivePagination",
            "SourceSetupPaginationMissing", "SourceSetupAiMissing", "SourceSetupAiRejected", "SourceSetupBusy", "SourceSetupTimeout"
        })
        {
            <span data-code="@key">@T[key]</span>
        }
    </div>
</section>
<form method="post" class="edit-form" id="source-editor">
    <input asp-for="Id" type="hidden"/>
    <input type="hidden" name="Version" value="@Convert.ToBase64String(Model.Version)"/>
    <partial name="_LocalizedValidation"/>
    @if (ViewData["DuplicateSourceName"] is string duplicateName)
    {
        <p class="validation" role="alert">@T["SourceSetupDuplicate", duplicateName]</p>
    }
    <div class="form-grid">
        <label>
            @T["Name"]
            <input asp-for="Name" maxlength="160" required/>
        </label>
        <label>
            @T["Url"]
            <input asp-for="Url" dir="ltr" type="url" required/>
        </label>
        <label>
            @T["Connector"]
            <select asp-for="Connector" id="source-connector">
                @foreach (var connector in Enum.GetValues<ConnectorKind>())
                {
                    <option value="@((int)connector)" data-help="@T["ConnectorHelp_"+connector]">
                        @UiMessages.Connector(connector.ToString(),T)
                    </option>
                }
            </select>
            <span id="connector-help" class="muted">@T["ConnectorHelp_"+Model.Connector]</span>
        </label>
        <label>
            @T["Interval"]
            <input asp-for="IntervalHours" type="number" min="1" max="168"/>
        </label>
        <label>
            @T["StartTime"]
            <input asp-for="CollectionStartTime" type="time" asp-format="{0:HH:mm}" required/>
            <span class="muted">@T["ScheduleZone"]</span>
        </label>
    </div>
    <label class="checkbox">
        <input asp-for="Enabled"/>
        @T["Enabled"]
    </label>
    <label class="checkbox">
        <input asp-for="UsageApproved"/>
        @T["Approval"]
    </label>
    <label>
        @T["ApprovalNote"]
        <textarea asp-for="ApprovalNote" rows="2" maxlength="2000"></textarea>
    </label>
    <p class="muted">@T["AutomaticSourceHelp"]</p>
    <details>
        <summary>@T["AdvancedSourceConfig"]</summary>
        <label>
            @T["Config"]
            <textarea asp-for="ConfigurationJson" rows="10" dir="ltr" spellcheck="false" maxlength="10000"></textarea>
        </label>
        <p class="muted">
            AllowedHosts · ListingLinkSelector · ContentSelector · WaitSelector · NextSelector · MaxPages
        </p>
    </details>
    <button class="button-outline" type="submit">@T["Save"]</button>
</form>
@section Scripts {
    <script src="~/js/source-setup.js" asp-append-version="true" defer></script>
}
