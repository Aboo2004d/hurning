@model Source
@{ViewData["Title"]=T["Source"];}
<partial name="_AdminNav"/><h1>@T["Source"]</h1><form method="post" class="edit-form"><input asp-for="Id" type="hidden"/><input type="hidden" name="Version" value="@Convert.ToBase64String(Model.Version)"/><partial name="_LocalizedValidation"/><div class="form-grid"><label>@T["Name"]<input asp-for="Name" maxlength="160" required/></label><label>@T["Url"]<input asp-for="Url" dir="ltr" type="url" required/></label><label>@T["Connector"]<select asp-for="Connector" id="source-connector">@foreach(var connector in Enum.GetValues<ConnectorKind>()){<option value="@((int)connector)" data-help="@T["ConnectorHelp_"+connector]">@UiMessages.Connector(connector.ToString(),T)</option>}</select><span id="connector-help" class="muted">@T["ConnectorHelp_"+Model.Connector]</span></label><label>@T["Interval"]<input asp-for="IntervalHours" type="number" min="1" max="168"/></label><label>@T["StartTime"]<input asp-for="CollectionStartTime" type="time" asp-format="{0:HH:mm}" required/><span class="muted">@T["ScheduleZone"]</span></label></div><label class="checkbox"><input asp-for="Enabled"/>@T["Enabled"]</label><label class="checkbox"><input asp-for="UsageApproved"/>@T["Approval"]</label><label>@T["ApprovalNote"]<textarea asp-for="ApprovalNote" rows="2" maxlength="2000"></textarea></label><p class="muted">@T["AutomaticSourceHelp"]</p><details><summary>@T["AdvancedSourceConfig"]</summary><label>@T["Config"]<textarea asp-for="ConfigurationJson" rows="10" dir="ltr" spellcheck="false" maxlength="10000"></textarea></label><p class="muted">AllowedHosts · ListingLinkSelector · ContentSelector · WaitSelector · NextSelector · MaxPages</p></details><button class="button-outline" type="submit">@T["Save"]</button></form>
