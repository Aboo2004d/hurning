@model SourceItem
@{ViewData["Title"]=T["Content"];}
<h1>@Model.Source.Name · @Model.ExternalId</h1><p>@T["Status"]: @UiMessages.State(Model.Status.ToString(),T)</p><div class="notice"><partial name="_Diagnostic" model="Model.Error"/></div><a href="@Model.Url" rel="noopener noreferrer">@T["Source"]</a><form asp-action="Retry" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="button-outline" type="submit">@T["Retry"]</button></form><h2>@T["Content"]</h2><pre dir="auto">@Model.Content</pre><h2>@T["Extraction"]</h2><pre dir="ltr">@Model.ExtractionJson</pre>
