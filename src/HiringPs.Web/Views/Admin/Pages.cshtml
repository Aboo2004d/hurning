@model List<SitePage>
@{ViewData["Title"]=T["PageContents"];}
<h1>@T["PageContents"]</h1><p class="muted">@T["PageContentsHelp"]</p>
<div class="managed-pages">
@foreach(var key in new[]{"about","privacy"})
{
 var page=Model.SingleOrDefault(x=>x.Key==key);
 <article class="detail-panel"><h2>@T[key=="about"?"About":"Privacy"]</h2><p class="muted">@if(page is null){@T["PageUsingDefault"]}else{@T["PageLastUpdated"] <span>@TimeZoneInfo.ConvertTime(page.UpdatedAt,TimeZoneInfo.FindSystemTimeZoneById("Asia/Hebron")).ToString("yyyy-MM-dd HH:mm")</span>}</p><div class="actions"><a class="button" asp-action="PageContent" asp-route-key="@key">@T["Edit"]</a><a class="textlink" asp-controller="Home" asp-action="@(key=="about"?"About":"Privacy")" target="_blank" rel="noopener noreferrer">@T["PreviewPage"]</a></div></article>
}
</div>
