@* One shared control: desktop actions and the mobile menu use the same markup. *@
<button class="theme-toggle secondary" type="button" data-theme-toggle hidden
        data-theme-light-label="@T["ThemeSwitchToLight"]" data-theme-dark-label="@T["ThemeSwitchToDark"]"
        aria-label="@T["ThemeSwitchToDark"]" title="@T["ThemeSwitchToDark"]">
    <svg data-theme-icon="dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M20.5 13.2A8.5 8.5 0 0 1 10.8 3.5 8.5 8.5 0 1 0 20.5 13.2Z" />
    </svg>
    <svg data-theme-icon="light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" hidden>
        <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <span data-theme-label>@T["ThemeSwitchToDark"]</span>
</button>
