@model SitePageViewModel
@if (Model.Questions.Count > 0)
{
<section id="common-questions" class="site-questions" aria-labelledby="common-questions-heading">
    <h2 id="common-questions-heading">@Model.QuestionsTitle</h2>
    @foreach (var item in Model.Questions)
    {
        <h3>@item.Question</h3>
        <p>@item.Answer</p>
    }
    <a class="textlink" asp-controller="Home" asp-action="Contact">@T["Contact"]</a>
</section>
}
