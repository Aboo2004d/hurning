@model PaymentOrder
<dl class="detail-grid">
    <div>
        <dt>@T["OrderId"]</dt>
        <dd>
            <bdi>@Model.Id</bdi>
        </dd>
    </div>
    <div>
        <dt>@T["Plan"]</dt>
        <dd>@Model.PlanVersion.Name(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)</dd>
    </div>
    <div>
        <dt>@T["Amount"]</dt>
        <dd><bdi dir="ltr">@MembershipRules.Money(Model.AmountIls)</bdi></dd>
    </div>
    <div>
        <dt>@T["PaymentGateway"]</dt><dd>@T[Model.Gateway == "discount" ? "DiscountPayment" : Model.Gateway]</dd>
    </div>
    <div>
        <dt>@T["Status"]</dt>
        <dd>@T["Payment" + Model.State]</dd>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ProviderReference))
    {
        <div>
            <dt>@T["Reference"]</dt>
            <dd dir="auto">@Model.ProviderReference</dd>
        </div>
    }
    <div>
        <dt>@T["CreatedPalestineTime"]</dt>
        <dd>
            <bdi>@PaymentDisplay.Time(Model.CreatedAt)</bdi>
        </dd>
    </div>
</dl>
