<div class="auth-provider">
    <div class="auth-provider-divider"><span>@T["ContinueVia"]</span></div>
    <form asp-area="" asp-controller="Google" asp-action="Start" method="post">
        <button type="submit" class="button button-outline auth-provider-button">
            <span class="fa-solid fa-google" aria-hidden="true"></span><span>@T["GoogleLogin"]</span>
        </button>
    </form>
</div>
