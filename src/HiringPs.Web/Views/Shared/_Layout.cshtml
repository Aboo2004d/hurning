@{var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";var returnUrl=Context.Request.Path+Context.Request.QueryString;}
<!DOCTYPE html><html lang="@(ar?"ar":"en")" dir="@(ar?"rtl":"ltr")"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · hiring.ps</title><meta name="description" content="@(ViewData["Description"]??T["Subtitle"].Value)"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><script src="~/js/site.js" asp-append-version="true" defer></script></head><body>
<header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brandmark">h</span>hiring.ps</a><nav><a asp-controller="Home" asp-action="Index">@T["Opportunities"]</a><a asp-controller="Home" asp-action="Index" asp-route-archive="true">@T["Archive"]</a>@if(User.IsInRole("Admin")){<a asp-controller="Admin" asp-action="Index">@T["Admin"]</a>}</nav><form asp-controller="Home" asp-action="Language" method="post"><input type="hidden" name="culture" value="@(ar?"en":"ar")"/><input type="hidden" name="returnUrl" value="@returnUrl"/><button class="secondary" type="submit">@(ar?"English":"العربية")</button></form></header>
<main class="container">@if(TempData["Notice"] is string notice){<div class="notice" role="status">@T[notice]</div>}@RenderBody()</main>
<footer><span>hiring.ps · @T["SourceLinkNote"]</span><a asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a><a asp-controller="Account" asp-action="Login">@T["Admin"]</a></footer>
@await RenderSectionAsync("Scripts",required:false)
</body></html>
