@{
 var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";
 var returnUrl=Context.Request.Path+Context.Request.QueryString;
 var activeKind=ViewData["ListingKind"] as OpportunityKind?;
 var archive=ViewData["ListingArchive"] is true;
 var action=ViewContext.RouteData.Values["action"]?.ToString();
 var listing=ViewContext.RouteData.Values["controller"]?.ToString()=="Home" && action is "Index" or "Details";
}
<!DOCTYPE html>
<html lang="@(ar?"ar":"en")" dir="@(ar?"rtl":"ltr")">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <link rel="icon" type="image/png" sizes="32x32" href="~/images/brand/favicon-32.png" asp-append-version="true"/>
 <link rel="icon" type="image/png" sizes="64x64" href="~/images/brand/favicon-64.png" asp-append-version="true"/>
 <link rel="apple-touch-icon" sizes="180x180" href="~/images/brand/apple-touch-icon.png" asp-append-version="true"/>
 <title>@ViewData["Title"] · hiring.ps</title>
 <meta name="description" content="@(ViewData["Description"]??T["Subtitle"].Value)"/>
 <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
 <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
<header class="topbar site-header">
 <a class="brand" asp-controller="Home" asp-action="Index" aria-label="@(ar?"hiring.ps — الرئيسية":"hiring.ps — Home")"><img class="brand-logo" src="~/images/brand/basket-logo.png" asp-append-version="true" width="56" height="56" alt="hiring.ps"/></a>
 <button class="header-menu-toggle secondary" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="@T["Menu"]"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
 <nav id="primary-navigation" class="header-nav" aria-label="@T["MainNavigation"]">
 @foreach(var kind in Enum.GetValues<OpportunityKind>())
 {
  var selected=listing&&!archive&&activeKind==kind;
  <a asp-controller="Home" asp-action="Index" asp-route-kind="@kind" class="@(selected?"is-current":null)" aria-current="@(selected?"page":null)">@T[kind==OpportunityKind.Job?"Jobs":kind.ToString()]</a>
 }
 <a asp-controller="Home" asp-action="Index" asp-route-archive="true" asp-route-kind="@activeKind" class="@(listing&&archive?"is-current":null)" aria-current="@(listing&&archive?"page":null)">@T["Archive"]</a>
 <a asp-controller="Home" asp-action="About" aria-current="@(action=="About"?"page":null)">@T["About"]</a>
 <a asp-controller="Home" asp-action="Contact" aria-current="@(action=="Contact"?"page":null)">@T["Contact"]</a>
 </nav>
 <div class="header-actions">
  <form asp-controller="Home" asp-action="Language" method="post"><input type="hidden" name="culture" value="@(ar?"en":"ar")"/><input type="hidden" name="returnUrl" value="@returnUrl"/><button class="secondary" type="submit">@(ar?"English":"العربية")</button></form>
  @if(User.IsInRole("Admin"))
  {
   <a class="header-account" asp-controller="Admin" asp-action="Index"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/></svg><span>@T["ControlPanel"]</span></a>
  }
  else
  {
   <a class="header-account" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Admin"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 4h6v16h-6M3 12h12m-4-4 4 4-4 4"/></svg><span>@T["LoginShort"]</span></a>
  }
 </div>
</header>
<main class="container">@if(TempData["Notice"] is string notice){<div class="notice" role="status">@T[notice]</div>}@RenderBody()</main>
<footer class="site-footer">
 <div class="footer-inner">
  <div class="footer-description"><span class="footer-copyright" dir="ltr">© @DateTime.UtcNow.Year hiring.ps</span><p>@T["SourceLinkNote"]</p></div>
  <nav class="footer-links" aria-label="@T["FooterNavigation"]"><a asp-controller="Home" asp-action="About">@T["About"]</a><a asp-controller="Home" asp-action="Contact">@T["Contact"]</a><a class="footer-privacy" asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a></nav>
 </div>
</footer>
@await RenderSectionAsync("Scripts",required:false)
</body>
</html>
