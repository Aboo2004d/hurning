@model SourceItemDetailsDto
@{
    var opportunities = HiringPs.Web.Services.Collection.SourceItemEvidencePresenter.Read(Model);
}
@if (opportunities is not null)
{
    <section class="detail-panel">
        <h2>@T["ProposedDates"]</h2>
        @if (Model.Content.Contains("[PDF DOCUMENT", StringComparison.Ordinal))
        {
            <p>@T["PdfFilesDeleted"] <a href="@Model.Url" rel="noopener noreferrer">@T["Source"]</a></p>
        }
        @foreach (var opportunity in opportunities)
        {
            <h3 dir="auto">@opportunity.Title</h3>
            @foreach (var date in opportunity.Dates)
            {
                <p>
                    <strong>@T["DateKind_" + date.Kind]</strong>
                    ·
                    <bdi>@date.Date.ToString("yyyy-MM-dd")</bdi>
                    · @date.Label
                </p>
                <blockquote dir="auto">@date.Evidence</blockquote>
                @if (date.PdfPage is { } page)
                {
                    <p>
                        <span>@T["PdfEvidencePage", page]</span>
                    </p>
                }
            }
        }
    </section>
}
