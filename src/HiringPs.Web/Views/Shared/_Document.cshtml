@inject SiteSeo Seo
@* القالب العام: بيانات SEO ثم تنبيه النسخة التجريبية والهيدر ومحتوى الصفحة والفوتر. *@
@{
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var activeKind = ViewData["ListingKind"] as OpportunityKind? ;
    var archive = ViewData["ListingArchive"] is true;
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var adminArea = ViewData["HeaderKind"] as string == "Admin";
    var metadata = Seo.Build(Context.Request, ViewData.Model, ViewData["Title"]?.ToString() ?? T["SiteName"].Value, ViewData["Description"]?.ToString() ?? T["Subtitle"].Value);
    var mount = Context.Items["MountPath"] is PathString mountPath ? mountPath.Value : "";
    // Share image per kind (procurement notices share the tenders image); generated by scripts/generate-share-images.cjs.
    var shareImage = activeKind switch
    {
        OpportunityKind.Job => "share-jobs.png",
        OpportunityKind.Training => "share-training.png",
        OpportunityKind.Tender or OpportunityKind.ProcurementNotice => "share-tenders.png",
        _ => "share.png",
    };
    var shareImageUrl = Seo.Origin + "/images/share/" + shareImage;
    var feedCity = (ViewData.Model as BrowseModel)?.BrowseCity;
    var feedUrl = !adminArea && ViewData.Model is ListingModel listing && ViewData.Model is not BrowseModel
        ? mount + FeedLinks.ForListing(listing)
        : activeKind is { } feedKind && !adminArea ? mount + HiringPs.Web.Controllers.FeedsController.Path(feedKind, feedCity) : null;
}
<!DOCTYPE html>
<html lang="@(ar?"ar":"en")" dir="@(ar?"rtl":"ltr")">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <!-- Google tag (gtag.js); initialization stays local to comply with CSP. -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-TTF6JQSFVP"></script>
        <script src="~/js/google-analytics.js" asp-append-version="true"></script>
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="~/images/brand/favicon-32.png"
            asp-append-version="true"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="64x64"
            href="~/images/brand/favicon-64.png"
            asp-append-version="true"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="~/images/brand/apple-touch-icon.png"
            asp-append-version="true"
        />
        <title>@metadata.Title</title>
        <meta name="description" content="@metadata.Description" />
        <meta name="robots" content="@metadata.Robots" />
        <link rel="canonical" href="@metadata.Canonical" />
        @if (!metadata.Robots.StartsWith("noindex"))
        {
            <link rel="alternate" hreflang="ar" href="@metadata.Arabic" />
            <link rel="alternate" hreflang="en" href="@metadata.English" />
            <link rel="alternate" hreflang="x-default" href="@metadata.Arabic" />
        }
        @if (metadata.Previous is not null)
        {
            <link rel="prev" href="@metadata.Previous" />
        }
        @if (metadata.Next is not null)
        {
            <link rel="next" href="@metadata.Next" />
        }
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@T["SiteName"]" />
        <meta property="og:title" content="@metadata.Title" />
        <meta property="og:description" content="@metadata.Description" />
        <meta property="og:url" content="@metadata.Canonical" />
        <meta property="og:locale" content="@(metadata.Language == "ar" ? "ar_PS" : "en_US")" />
        <meta property="og:locale:alternate" content="@(metadata.Language == "ar" ? "en_US" : "ar_PS")" />
        <meta property="og:image" content="@shareImageUrl" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="@T["SiteName"]" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@metadata.Title" />
        <meta name="twitter:description" content="@metadata.Description" />
        <meta name="twitter:image" content="@shareImageUrl" />
        @if (feedUrl is not null)
        {
            <link rel="alternate" type="application/rss+xml" title="@T["RssFeed"]" href="@feedUrl" />
        }
        <link rel="preload" href="@(mount + "/vendor/fonts/cairo/cairo-" + (ar ? "arabic" : "latin") + "-wght-normal.woff2")" as="font" type="font/woff2" crossorigin />

        @if (metadata.StructuredData.Length > 0)
        {
            <script type="application/ld+json">@Html.Raw(metadata.StructuredData)</script>
        }
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
        <script src="~/js/site.js" asp-append-version="true" defer>
        </script>
        <script src="~/js/member-actions.js" asp-append-version="true" defer></script>
    </head>
    <body class="@(adminArea ? "admin-area" : null)">
        <a class="skip-link" href="#main-content">@T["SkipToContent"]</a>
        @if (!adminArea)
        {
            <aside class="beta-banner" aria-label="@T["BetaBadge"]" data-beta-banner>
                <div class="beta-banner-inner">
                    <span class="beta-badge">@T["BetaBadge"]</span>
                    <p>@T["BetaMessage"]</p>
                    <button class="beta-dismiss" type="button" aria-label="@T["DismissBeta"]" data-beta-dismiss>
                        <svg
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            aria-hidden="true"
                        >
                            <path d="m6 6 12 12M6 18 18 6" />
                        </svg>
                    </button>
                </div>
            </aside>
        }
        @await RenderSectionAsync("Header", required: true)
        <div class="page-loader" data-page-loader hidden role="status" aria-live="polite">
            <img src="~/images/brand/basket-logo.png" width="72" height="72" alt="" />
            <span>@T["Loading"]</span>
        </div>
        <main class="container" id="main-content" tabindex="-1">
            @if (TempData["Notice"] is string notice)
            {
                <div class="notice" role="status">
                    @T[notice]
                </div>
            }
            @RenderBody()
        </main>
        <footer class="site-footer">
            <div class="footer-inner">
                <div class="footer-description">
                    <span class="footer-brand">
                        <img src="~/images/brand/basket-logo.png" width="40" height="40" alt="" />
                        <bdi>@T["SiteName"]</bdi>
                    </span>
                    <p>
                        @T["SourceLinkNote"]
                    </p>
                    <span class="footer-copyright">© @DateTime.UtcNow.Year <bdi>@T["SiteName"]</bdi></span>
                </div>
                @if (!adminArea)
                {
                    <nav class="footer-links footer-browse" aria-label="@T["OpportunityTypes"]">
                        <strong>@T["OpportunityTypes"]</strong>
                        @foreach (var kind in Enum.GetValues<OpportunityKind>())
                        {
                            <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-kind="@kind">@T[kind == OpportunityKind.Job ? "Jobs" : kind.ToString()]</a>
                        }
                        <a href="@(mount + "/feeds/jobs.xml")" type="application/rss+xml">
                            <span class="fa-solid fa-rss" aria-hidden="true"></span>
                            @T["RssFeed"]
                        </a>
                    </nav>
                }
                <nav class="footer-links" aria-label="@T["FooterNavigation"]">
                    <strong>@T["SiteName"]</strong>
                    <a asp-area="" asp-controller="About" asp-action="Index">
                        @T["About"]
                    </a>
                    <a asp-area="" asp-controller="Contact" asp-action="Index">
                        @T["Contact"]
                    </a>
                    <a class="footer-privacy" asp-area="" asp-controller="Privacy" asp-action="Index">
                        @T["Privacy"]
                    </a>
                </nav>
            </div>
        </footer>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
