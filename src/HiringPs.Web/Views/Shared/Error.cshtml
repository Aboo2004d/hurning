@model ErrorViewModel
@{
    ViewData["Title"] = T["Error" + Model.StatusCode];
}
<section class="error-panel">
    <img src="~/images/brand/basket-logo.png" width="72" height="72" alt="" />
    <p class="error-code" dir="ltr">@Model.StatusCode</p>
    <h1>@T["Error" + Model.StatusCode]</h1>
    <p>@T["ErrorAdvice"]</p>
    <div class="actions">
        <a class="button" asp-area="" asp-controller="Home" asp-action="Index">@T["BackHome"]</a>
        @if (Model.StatusCode is 408 or 429 or 500 or 502 or 503 or 504)
        {
            <button class="secondary" type="button" data-retry-page>@T["Retry"]</button>
        }
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="muted">@T["SupportReference"]: <bdi>@Model.RequestId</bdi></p>
    }
</section>
