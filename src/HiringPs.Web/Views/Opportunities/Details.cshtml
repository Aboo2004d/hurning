@model Opportunity
@* تفاصيل فرصة واحدة مع مصدر الإعلان وروابط التقديم والمرفقات ونموذج البلاغ. *@
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var expired = Model.Status == PublicationStatus.Archived || (Model.Deadline is { } d && d < TextRules.PalestineToday());
    var sourceUrl = Model.SourceLinks.FirstOrDefault()?.SourceItem.Url;
    var english = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    var organizationFacet = ViewBag.OrganizationFacet as OrganizationFacet;
    var cityLinks = ViewBag.CityFacets as List<City> ?? [];
    var attachments = ViewBag.Attachments as List<string> ?? [];
    var closing = expired ? null : PublicListing.ClosingInDays(Model, TextRules.PalestineToday());
}
<a class="textlink back-link" asp-controller="Home" asp-action="Index" asp-route-kind="@Model.Kind">
    <span class="fa-solid @(english ? "fa-arrow-left" : "fa-arrow-right")" aria-hidden="true"></span>
    <span>@T["Back"]</span>
</a>
<article class="detail-panel">
    <div class="card-top">
        @if (organizationFacet is not null)
        {
            <a dir="auto" href="@Url.Content("~" + HiringPs.Web.Controllers.BrowsePaths.Organization(organizationFacet.Slug))">@Model.Organization</a>
        }
        else
        {
            <span dir="auto">@Model.Organization</span>
        }
        <span class="card-badges">
            @if (closing is { } days)
            {
                <partial name="_ClosingBadge" model="days" />
            }
            <span class="badge">@T[Model.Kind.ToString()]</span>
        </span>
    </div>
    <h1 dir="auto" lang="@Model.OriginalLanguage">@Model.Title</h1>
    @if (expired)
    {
        <div class="notice">@T["Expired"]</div>
    }
    <dl class="detail-grid">
        <div>
            <dt>@T["Location"]</dt>
            <dd dir="auto">
                @Model.Locations
                @foreach (var city in cityLinks)
                {
                    var kindLabel = T[Model.Kind == OpportunityKind.Job ? "Jobs" : Model.Kind.ToString()].Value;
                    <a class="detail-browse-link" href="@Url.Content("~" + HiringPs.Web.Controllers.BrowsePaths.City(Model.Kind, city))">
                        @string.Format(CultureInfo.CurrentCulture, T["BrowseCityHeading"].Value, kindLabel, city.Name(english))
                    </a>
                }
            </dd>
        </div>
        <div>
            <dt>@T["Category"]</dt>
            <dd dir="auto">@FilterLabels.Category(Model.Category, english)</dd>
        </div>
        <div>
            <dt>@T["Deadline"]</dt>
            <dd>@(Model.Deadline?.ToString("yyyy-MM-dd")??T["UnknownDeadline"].Value)</dd>
        </div>
        <div>
            <dt>@T["AddedToSite"]</dt>
            <dd>@TimeZoneInfo.ConvertTime(Model.CreatedAt, SourceSchedule.Zone).ToString("yyyy-MM-dd")</dd>
        </div>
        @if (Model.SourcePublishedAt is { } published)
        {
            <div>
                <dt>@T["DateKind_Publication"]</dt>
                <dd>@TimeZoneInfo.ConvertTime(published, SourceSchedule.Zone).ToString("yyyy-MM-dd")</dd>
            </div>
        }
        @if (Model.SourceModifiedAt is { } modified)
        {
            <div>
                <dt>@T["DateKind_Modification"]</dt>
                <dd>@TimeZoneInfo.ConvertTime(modified, SourceSchedule.Zone).ToString("yyyy-MM-dd")</dd>
            </div>
        }
        <div>
            <dt>@T["Verified"]</dt>
            <dd>@TimeZoneInfo.ConvertTime(Model.LastVerifiedAt, SourceSchedule.Zone).ToString("yyyy-MM-dd")</dd>
        </div>
        @if (Model.Kind == OpportunityKind.Job)
        {
            <div>
                <dt>@T["Employment"]</dt>
                <dd dir="auto">@FilterLabels.Employment(Model.EmploymentType, english)</dd>
            </div>
            <div>
                <dt>@T["Experience"]</dt>
                <dd dir="auto">@FilterLabels.Experience(Model.ExperienceLevel, english)</dd>
            </div>
        }
        else if (Model.Kind == OpportunityKind.Training)
        {
            <div>
                <dt>@T["Duration"]</dt>
                <dd>@Model.Duration</dd>
            </div>
            <div>
                <dt>@T["Cost"]</dt>
                <dd>@Model.Cost</dd>
            </div>
        }
        else
        {
            <div>
                <dt>@T["Reference"]</dt>
                <dd dir="auto">@Model.ReferenceNumber</dd>
            </div>
        }
        @if (Model.Eligibility.Length > 0)
        {
            <div>
                <dt>@T["Eligibility"]</dt>
                <dd dir="auto">@Model.Eligibility</dd>
            </div>
        }
    </dl>
    <h2>@T["Summary"]</h2>
    <p dir="auto" lang="@Model.OriginalLanguage">@Model.Summary</p>
    <p class="muted">@T["SummaryNote"]</p>
    <div class="actions">
        @if (sourceUrl is not null)
        {
            <a class="button" href="@sourceUrl" rel="noopener noreferrer">@T["Original"]</a>
        }
        else if (!expired && Model.ApplyUrl.Length > 0)
        {
            <a class="button" href="@Model.ApplyUrl" rel="noopener noreferrer">@T["Original"]</a>
        }
    </div>
    <div class="sources">
        @foreach (var link in Model.SourceLinks)
        {
            <a href="@link.SourceItem.Url" rel="noopener noreferrer">@link.SourceItem.Source.Name</a>
        }
    </div>
    @if (attachments.Count > 0)
    {
        <div class="sources">
            @foreach (var file in attachments)
            {
                <a href="@file" rel="noopener noreferrer">@T["ListingAttachment"]</a>
            }
        </div>
    }
    <partial name="_ShareButtons" model="Model" />
    @if (organizationFacet is not null)
    {
        <p class="detail-more">
            <a class="textlink" href="@Url.Content("~" + HiringPs.Web.Controllers.BrowsePaths.Organization(organizationFacet.Slug))">
                <span class="fa-solid fa-building" aria-hidden="true"></span>
                <span>@T["MoreFromOrganization"]</span>
                <bdi>@organizationFacet.Name</bdi>
            </a>
        </p>
    }
    <details class="report-panel">
        <summary>@T["Report"]</summary>
        <form asp-action="Report" method="post">
            <input type="hidden" name="id" value="@Model.Id"/>
            <label>
                @T["ReportReason"]
                <select name="reason">
                    @foreach (var value in new[]
                    {
                        "expired",
                        "duplicate",
                        "incorrect",
                        "broken",
                        "other"
                    }
                    )
                    {
                        <option value="@value">@T[value=="expired"?"Report_expired":value]</option>
                    }
                </select>
            </label>
            <label>
                @T["ReportDetails"]
                <textarea name="details" maxlength="1000" rows="3"></textarea>
            </label>
            <button type="submit">@T["Send"]</button>
        </form>
    </details>
</article>
@if (ViewBag.VerifiedDates is IEnumerable<OpportunityDateRecord> dateRecords)
{
    <section class="detail-panel">
        <h2>@T["VerifiedSourceDates"]</h2>
        @foreach (var date in dateRecords.GroupBy(x => new { x.Kind, Label = x.Kind is OpportunityDateKind.Publication or OpportunityDateKind.Modification or OpportunityDateKind.Deadline ? "" : x.Label, Date = x.Kind is OpportunityDateKind.Publication or OpportunityDateKind.Modification or OpportunityDateKind.Deadline ? DateOnly.MinValue : x.Date }).Select(g => g.First()))
        {
            <p>
                <strong>@T["DateKind_" + date.Kind]</strong>
                ·
                <bdi>@date.Date.ToString("yyyy-MM-dd")</bdi>
                @if (date.IsExtension)
                {
                    <span class="badge">@T["DeadlineExtension"]</span>
                }
            </p>
            <p dir="auto">@date.Label</p>
            <blockquote dir="auto">@date.Evidence</blockquote>
        }
        <p class="muted">@T["SystemDatesNote"]</p>
    </section>
}

@if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
{
    <form id="save-@Model.Id" asp-area="Member" asp-controller="Saved" asp-action="Add" method="post" data-save-opportunity>
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
        <partial name="_SaveOpportunityButton" model="new SaveButton(Model.Id, ViewBag.IsSaved is true)" />
    </form>
}

@section Scripts {
    <script src="~/js/share.js" asp-append-version="true" defer></script>
}
