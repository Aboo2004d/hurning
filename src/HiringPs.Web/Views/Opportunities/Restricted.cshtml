@model OpportunityKind
@{ ViewData["Title"] = T["SubscriberContent"]; }
<section class="error-panel">
    <h1>@T["SubscriberContent"]</h1>
    <p class="subscriber-details-hint">@T["SubscribeForDetails"]</p>
    <p>@T["RestrictedAdvice"] — @T[Model.ToString()]</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="button" asp-area="Member" asp-controller="Plans" asp-action="Index">@T["ViewPlans"]</a>
    }
    else
    {
        <div class="actions">
            <a class="button" asp-controller="Registration" asp-action="Index">@T["Register"]</a>
            <a class="button button-outline" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path)">@T["Login"]</a>
        </div>
    }
</section>
