@model HiringPs.Web.Controllers.LoginInput
@{
    ViewData["Title"] = T["Login"];
}
<section class="login-panel">
    <h1>@T["Login"]</h1>
    @if (ViewBag.SuspensionReason is string reason) { <p class="notice" dir="auto">@reason</p> }
    <form method="post">
        <input asp-for="ReturnUrl" type="hidden"/>
        @foreach (var entry in ViewData.ModelState.Values.SelectMany(x => x.Errors))
        {
            <div class="validation" role="alert">@T[entry.ErrorMessage]</div>
        }
        <label>
            @T["Email"]
            <input asp-for="Email" autocomplete="username" dir="ltr"/>
        </label>
        <label>
            @T["Password"]
            <input asp-for="Password" autocomplete="current-password"/>
        </label>
        <button class="button button-outline auth-submit" type="submit"><span class="fa-solid fa-key" aria-hidden="true"></span>@T["Login"]</button>
    </form>
    <nav class="auth-actions" aria-label="@T["AccountSettings"]">
        <a class="button button-outline" asp-controller="Registration" asp-action="Index"><span class="fa-solid fa-user" aria-hidden="true"></span>@T["Register"]</a>
        <a class="button button-outline" asp-controller="PasswordReset" asp-action="Index"><span class="fa-solid fa-key" aria-hidden="true"></span>@T["ResetPassword"]</a>
    </nav>
    <partial name="_GoogleLogin" />
</section>
