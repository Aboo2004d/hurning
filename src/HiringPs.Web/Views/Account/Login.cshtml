@model HiringPs.Web.Controllers.LoginInput
@{
    ViewData["Title"] = T["Login"];
}
<section class="login-panel">
    <h1>@T["Login"]</h1>
    @if (ViewBag.SuspensionReason is string reason) { <p class="notice" dir="auto">@reason</p> }
    <form method="post">
        <input asp-for="ReturnUrl" type="hidden"/>
        @foreach (var entry in ViewData.ModelState.Values.SelectMany(x => x.Errors))
        {
            <div class="validation" role="alert">@T[entry.ErrorMessage]</div>
        }
        <label>
            @T["Email"]
            <input asp-for="Email" autocomplete="username" dir="ltr"/>
        </label>
        <label>
            @T["Password"]
            <input asp-for="Password" autocomplete="current-password"/>
        </label>
        <button type="submit">@T["Login"]</button>
    </form>
    <p><a asp-controller="Registration" asp-action="Index">@T["Register"]</a></p>
    <p><a asp-controller="PasswordReset" asp-action="Index">@T["ResetPassword"]</a></p>
</section>
