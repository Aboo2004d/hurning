@model HiringPs.Web.Controllers.PasswordInput
@{var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";ViewData["Title"]=ar?"تغيير كلمة المرور":"Change password";}
<partial name="_AdminNav"/><section class="login-panel"><h1>@ViewData["Title"]</h1><form method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label>@(ar?"كلمة المرور الحالية":"Current password")<input asp-for="CurrentPassword" autocomplete="current-password"/></label><label>@(ar?"كلمة المرور الجديدة":"New password")<input asp-for="NewPassword" autocomplete="new-password"/></label><label>@(ar?"تأكيد كلمة المرور":"Confirm password")<input asp-for="ConfirmPassword" autocomplete="new-password"/></label><button type="submit">@T["Save"]</button></form></section>
